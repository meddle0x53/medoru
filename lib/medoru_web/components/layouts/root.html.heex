<!DOCTYPE html>
<html lang={@conn.assigns[:locale] || "en"} data-theme={@conn.assigns[:current_scope][:theme] || "system"}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title default="Medoru" suffix=" · Learn Japanese">
      {assigns[:page_title]}
    </.live_title>
    <link rel="icon" type="image/svg+xml" href={~p"/images/medoru-icon.png"} />
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
    <script>
      (() => {
        const serverTheme = document.documentElement.getAttribute("data-theme");
        const setTheme = (theme) => {
          if (theme === "system") {
            localStorage.removeItem("phx:theme");
            document.documentElement.removeAttribute("data-theme");
          } else {
            localStorage.setItem("phx:theme", theme);
            document.documentElement.setAttribute("data-theme", theme);
          }
        };
        if (serverTheme) {
          setTheme(serverTheme);
        } else if (!document.documentElement.hasAttribute("data-theme")) {
          setTheme(localStorage.getItem("phx:theme") || "system");
        }
        window.addEventListener("storage", (e) => e.key === "phx:theme" && setTheme(e.newValue || "system"));

        window.addEventListener("phx:set-theme", (e) => setTheme(e.detail.theme));
      })();
    </script>
  </head>
  <body>
    {@inner_content}
    <script>
      // Set locale for LiveViews
      window.medoruLocale = "{@conn.assigns[:locale] || "en"}";

      // Format timestamps to browser-local time
      (function() {
        function fmt(el) {
          var iso = el.getAttribute("data-local-time");
          if (!iso || el.getAttribute("data-local-time-formatted")) return;
          var d = new Date(iso);
          if (isNaN(d)) return;
          var opts = el.getAttribute("data-local-time-type") === "date"
            ? { year: "numeric", month: "long", day: "numeric" }
            : { hour: "2-digit", minute: "2-digit", hour12: false };
          el.textContent = new Intl.DateTimeFormat(undefined, opts).format(d);
          el.setAttribute("data-local-time-formatted", "true");
        }

        document.querySelectorAll("[data-local-time]").forEach(fmt);

        var obs = new MutationObserver(function(mutations) {
          mutations.forEach(function(m) {
            m.addedNodes.forEach(function(n) {
              if (n.nodeType === 1) {
                if (n.matches && n.matches("[data-local-time]")) fmt(n);
                if (n.querySelectorAll) n.querySelectorAll("[data-local-time]").forEach(fmt);
              }
            });
          });
        });
        if (document.body) obs.observe(document.body, { childList: true, subtree: true });
      })();
    </script>
  </body>
</html>
