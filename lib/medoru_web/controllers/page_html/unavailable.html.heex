<div class="min-h-screen flex items-center justify-center bg-base-200 px-4">
  <div class="text-center max-w-md">
    <div class="mb-6">
      <.icon name="hero-no-symbol" class="w-20 h-20 text-error mx-auto" />
    </div>
    <h1 class="text-3xl font-bold text-base-content mb-4">
      {gettext("Site is not available at the moment")}
    </h1>
    <p class="text-base-content/70 mb-8">
      {gettext(
        "Your account has been temporarily suspended. Please contact support if you believe this is an error."
      )}
    </p>
    <.link navigate={~p"/"} class="btn btn-primary">
      <.icon name="hero-home" class="w-5 h-5 mr-2" />
      {gettext("Back to Home")}
    </.link>
  </div>
</div>
