<div class="min-h-screen bg-base-200 flex flex-col items-center p-4 justify-center max-lg:justify-start">
  <div class="mb-4 text-center">
    <h1 class="text-3xl font-bold text-primary">The Hollow Ouroboros</h1>
    <p class="text-secondary text-sm mt-1">Admin Battle MVP — v0.1.1</p>
  </div>

  <div
    id="game-wrapper"
    class="relative bg-base-300 rounded-xl shadow-2xl overflow-hidden"
    style="max-width: 100%; width: 960px; height: 540px; touch-action: none;"
    phx-update="ignore"
    phx-hook="GameHook"
    data-game-data={@game_data}
    data-game-script-url={~p"/assets/js/game.js?v=455"}
  >
    <style>
      #game-wrapper:fullscreen {
        width: 100vw !important;
        height: 100vh !important;
        max-width: none !important;
        border-radius: 0 !important;
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
        background: #000 !important;
      }
      #game-wrapper:fullscreen #game-container {
        width: 100% !important;
        height: 100% !important;
      }
      body.game-keyboard-open {
        overflow: hidden !important;
      }
      body.game-keyboard-open #game-wrapper:not(:fullscreen) {
        position: fixed !important;
        top: var(--gk-top) !important;
        left: var(--gk-left) !important;
        width: var(--gk-width) !important;
        height: var(--gk-height) !important;
        transform: none !important;
        max-width: none !important;
        z-index: 9999 !important;
      }
      #game-container canvas {
        touch-action: none !important;
        user-select: none !important;
        -webkit-user-select: none !important;
        -webkit-tap-highlight-color: transparent !important;
      }
      .game-spinner {
        width: 40px;
        height: 40px;
        border: 4px solid #2c3e50;
        border-top-color: #3498db;
        border-radius: 50%;
        animation: game-spin 1s linear infinite;
      }
      @keyframes game-spin {
        to { transform: rotate(360deg); }
      }
      @media (max-width: 960px) {
        #game-wrapper {
          width: auto !important;
          height: auto !important;
          max-width: 100% !important;
          max-height: calc(100dvh - 8rem) !important;
          aspect-ratio: 16 / 9 !important;
        }
      }
    </style>
    <div
      id="game-loading-overlay"
      style="position:absolute; inset:0; display:flex; flex-direction:column; align-items:center; justify-content:center; background:#1a1a2e; z-index:50;"
    >
      <div class="game-spinner"></div>
      <p style="margin-top:12px; color:#bdc3c7; font-family:sans-serif; font-size:14px;">
        Loading game...
      </p>
    </div>
    <div id="game-container" style="width: 100%; height: 100%;"></div>
  </div>

  <div class="mt-4 text-center text-xs text-secondary max-w-xl">
    <p>
      Type the reading of the shown kanji within the time limit to execute skills at full power.
    </p>
    <p class="mt-1">Perfect (fast) = 125% · Success = 100% · Fail = 50%</p>
  </div>
</div>
