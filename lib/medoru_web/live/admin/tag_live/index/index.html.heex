<Layouts.app flash={@flash} current_scope={@current_scope} socket={@socket}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <%!-- Header --%>
    <div class="mb-8 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <div>
        <div class="flex items-center gap-2 mb-2">
          <.link navigate={~p"/admin"} class="btn btn-sm btn-ghost">
            <.icon name="hero-arrow-left" class="w-4 h-4" />
          </.link>
          <h1 class="text-3xl font-bold text-base-content">{gettext("Tag Management")}</h1>
        </div>
        <p class="mt-1 text-secondary">
          {gettext("Manage user profile tags. Total: %{count}", count: @total_count)}
        </p>
      </div>
      <.link
        navigate={~p"/admin/tags/new"}
        class="btn btn-primary w-full sm:w-auto min-h-[44px] touch-target"
      >
        <.icon name="hero-plus" class="w-5 h-5 mr-2" /> {gettext("Add Tag")}
      </.link>
    </div>

    <%!-- Filters --%>
    <div class="card bg-base-100 shadow-sm border border-base-300 mb-6">
      <div class="card-body p-4 sm:p-6">
        <div class="flex flex-col gap-4">
          <%!-- Category Filter --%>
          <div class="flex flex-col sm:flex-row sm:items-center gap-2">
            <span class="text-sm font-medium text-base-content/70 shrink-0">
              {gettext("Filter by category:")}
            </span>
            <div class="flex flex-wrap gap-1">
              <button
                phx-click="filter_category"
                phx-value-category=""
                class={[
                  "btn btn-sm min-h-[40px] touch-target",
                  if(is_nil(@category_filter), do: "btn-active btn-primary", else: "btn-ghost")
                ]}
              >
                {gettext("All")}
              </button>
              <%= for {label, value} <- @categories do %>
                <button
                  phx-click="filter_category"
                  phx-value-category={value}
                  class={[
                    "btn btn-sm min-h-[40px] touch-target",
                    if(@category_filter == value,
                      do: "btn-active btn-primary",
                      else: "btn-ghost"
                    )
                  ]}
                >
                  {label}
                </button>
              <% end %>
            </div>
          </div>

          <%!-- Search --%>
          <.form
            for={%{}}
            phx-submit="search"
            class="flex flex-col sm:flex-row items-stretch sm:items-center gap-2 w-full"
          >
            <div class="join w-full sm:flex-1">
              <input
                type="text"
                name="search[query]"
                value={@search}
                placeholder={gettext("Search tag name...")}
                class="join-item input input-bordered w-full text-base min-h-[48px]"
              />
            </div>
            <div class="flex gap-2">
              <button
                type="submit"
                class="btn btn-primary min-h-[48px] touch-target flex-1 sm:flex-none px-4"
              >
                <.icon name="hero-magnifying-glass" class="w-5 h-5 sm:mr-2" />
                <span class="hidden sm:inline">{gettext("Search")}</span>
              </button>
              <%= if @search || @category_filter do %>
                <button
                  type="button"
                  phx-click="clear_filters"
                  class="btn btn-ghost min-h-[48px] touch-target px-4"
                >
                  {gettext("Clear")}
                </button>
              <% end %>
            </div>
          </.form>
        </div>
      </div>
    </div>

    <%!-- Tags Table --%>
    <div class="card bg-base-100 shadow-sm border border-base-300 overflow-hidden">
      <div class="overflow-x-auto">
        <table class="table">
          <thead>
            <tr>
              <th>{gettext("Name")}</th>
              <th>{gettext("Slug")}</th>
              <th>{gettext("Category")}</th>
              <th>{gettext("Color")}</th>
              <th>{gettext("Order")}</th>
              <th class="text-right">{gettext("Actions")}</th>
            </tr>
          </thead>
          <tbody>
            <%= for tag <- @tags do %>
              <tr class="hover:bg-base-200/50">
                <td>
                  <div class="flex items-center gap-2">
                    <span class={["badge", tag_color_classes(tag.color)]}>
                      {tag.name}
                    </span>
                  </div>
                </td>
                <td class="font-mono text-sm text-base-content/60">{tag.slug}</td>
                <td>
                  <span class="badge badge-sm badge-ghost">{tag.category}</span>
                </td>
                <td>
                  <span class={["badge badge-sm", tag_color_classes(tag.color)]}>
                    {tag.color}
                  </span>
                </td>
                <td class="text-sm text-base-content/60">{tag.order_index}</td>
                <td class="text-right">
                  <div class="flex gap-1 justify-end">
                    <.link
                      navigate={~p"/admin/tags/#{tag.id}/edit"}
                      class="btn btn-ghost btn-sm min-h-[36px] min-w-[36px] touch-target"
                      title={gettext("Edit")}
                    >
                      <.icon name="hero-pencil" class="w-4 h-4" />
                    </.link>
                    <button
                      phx-click="delete"
                      phx-value-id={tag.id}
                      data-confirm={gettext("Are you sure you want to delete this tag?")}
                      class="btn btn-ghost btn-sm text-error min-h-[36px] min-w-[36px] touch-target"
                      title={gettext("Delete")}
                    >
                      <.icon name="hero-trash" class="w-4 h-4" />
                    </button>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>

    <%= if @tags == [] do %>
      <div class="p-12 text-center">
        <.icon name="hero-tag" class="w-12 h-12 text-base-content/30 mx-auto mb-4" />
        <p class="text-base-content/50">{gettext("No tags found matching your criteria.")}</p>
      </div>
    <% end %>

    <%!-- Pagination --%>
    <%= if @total_pages > 1 do %>
      <div class="flex items-center justify-between mt-6">
        <div class="text-sm text-base-content/60">
          {gettext("Page %{page} of %{total}", page: @page, total: @total_pages)}
        </div>
        <div class="join">
          <.link
            navigate={
              if @page > 1,
                do:
                  ~p"/admin/tags?#{%{page: @page - 1, category: @category_filter, search: @search}}",
                else: "#"
            }
            class={["join-item btn btn-sm min-w-[40px]", if(@page <= 1, do: "btn-disabled")]}
          >
            <.icon name="hero-chevron-left" class="w-4 h-4" />
          </.link>
          <%= for page_num <- 1..@total_pages do %>
            <%= if abs(page_num - @page) <= 2 or page_num == 1 or page_num == @total_pages do %>
              <.link
                navigate={
                  ~p"/admin/tags?#{%{page: page_num, category: @category_filter, search: @search}}"
                }
                class={[
                  "join-item btn btn-sm w-10 h-10 min-w-[40px] max-w-[40px] p-0",
                  if(page_num == @page, do: "btn-active btn-primary", else: "btn-ghost")
                ]}
              >
                {page_num}
              </.link>
            <% end %>
          <% end %>
          <.link
            navigate={
              if @page < @total_pages,
                do:
                  ~p"/admin/tags?#{%{page: @page + 1, category: @category_filter, search: @search}}",
                else: "#"
            }
            class={[
              "join-item btn btn-sm min-w-[40px]",
              if(@page >= @total_pages, do: "btn-disabled")
            ]}
          >
            <.icon name="hero-chevron-right" class="w-4 h-4" />
          </.link>
        </div>
      </div>
    <% end %>
  </div>
</Layouts.app>
