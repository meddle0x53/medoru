<%= if @show_relations_modal do %>
  <div class="modal modal-open">
    <div class="modal-box max-w-3xl max-h-[90vh] flex flex-col">
      <h3 class="font-bold text-lg flex items-center gap-2 mb-4">
        <.icon name="hero-link" class="w-5 h-5 text-secondary" />
        {gettext("Word Relations")}
      </h3>

      <div class="space-y-4 flex-1 overflow-y-auto">
        <%!-- Word info --%>
        <div class="p-3 bg-base-200 rounded-lg flex flex-col sm:flex-row gap-4">
          <div>
            <span class="text-sm text-base-content/60">{gettext("Word")}:</span>
            <span class="text-xl font-medium ml-2">{@word.text}</span>
          </div>
          <div>
            <span class="text-sm text-base-content/60">{gettext("Meaning")}:</span>
            <span class="font-medium ml-2">{@word.meaning}</span>
          </div>
        </div>

        <%!-- Manual relation form --%>
        <div class="border border-base-300 rounded-lg overflow-hidden">
          <div class="bg-base-200 px-4 py-2 font-medium flex items-center gap-2">
            <.icon name="hero-plus-circle" class="w-4 h-4" />
            {gettext("Add relation manually")}
          </div>

          <div class="p-4 space-y-4">
            <.form
              for={}
              id="manual-relation-form"
              phx-submit="add_manual_relation"
              class="space-y-4"
            >
              <div>
                <label class="label">
                  <span class="label-text">{gettext("Relation type")}</span>
                </label>
                <select
                  name="type"
                  phx-change="update_manual_relation_type"
                  class="select select-bordered w-full"
                >
                  <%= for {value, label} <- [{"synonym", gettext("Synonym")}, {"antonym", gettext("Antonym")}, {"expression", gettext("Expression")}] do %>
                    <option value={value} selected={@manual_relation_type == value}>
                      {label}
                    </option>
                  <% end %>
                </select>
              </div>

              <%= if @manual_relation_type == "expression" do %>
                <div>
                  <label class="label">
                    <span class="label-text">{gettext("Expression text")}</span>
                  </label>
                  <input
                    type="text"
                    name="expression"
                    value={@manual_relation_expression_text}
                    phx-change="update_manual_relation_expression"
                    phx-debounce="300"
                    placeholder={gettext("e.g., 日本に行く")}
                    class="input input-bordered w-full"
                  />
                </div>
              <% end %>

              <div>
                <label class="label">
                  <%= if @manual_relation_type == "expression" do %>
                    <span class="label-text">{gettext("Linked word (optional)")}</span>
                  <% else %>
                    <span class="label-text">{gettext("Related word")}</span>
                  <% end %>
                </label>
                <input
                  type="text"
                  name="search"
                  value={@manual_relation_search}
                  phx-change="update_manual_relation_search"
                  phx-debounce="300"
                  placeholder={gettext("Search words...")}
                  class="input input-bordered w-full"
                />

                <%= if @manual_relation_selected_word_id do %>
                  <p class="text-sm text-success mt-2">
                    {gettext("Selected word ID: %{id}", id: @manual_relation_selected_word_id)}
                  </p>
                <% end %>

                <%= if @manual_relation_results != [] do %>
                  <div class="mt-2 border border-base-300 rounded-lg divide-y divide-base-300 max-h-48 overflow-y-auto">
                    <%= for result <- @manual_relation_results do %>
                      <button
                        type="button"
                        phx-click="select_manual_relation_word"
                        phx-value-word_id={result.id}
                        class={[
                          "w-full text-left px-3 py-2 flex items-center justify-between hover:bg-base-200",
                          @manual_relation_selected_word_id == result.id && "bg-primary/10"
                        ]}
                      >
                        <span class="font-medium">{result.text}</span>
                        <span class="text-sm text-secondary">{result.reading}</span>
                      </button>
                    <% end %>
                  </div>
                <% end %>
              </div>

              <%= if @manual_relation_error do %>
                <div class="alert alert-error alert-soft">
                  <.icon name="hero-exclamation-triangle" class="w-5 h-5" />
                  <span>{@manual_relation_error}</span>
                </div>
              <% end %>

              <div class="modal-action flex-col sm:flex-row gap-2">
                <button type="submit" class="btn btn-primary w-full sm:w-auto">
                  <.icon name="hero-plus" class="w-4 h-4 mr-2" />
                  {gettext("Add Relation")}
                </button>
              </div>
            </.form>
          </div>
        </div>

        <%!-- Prompt textarea --%>
        <.form
          for={}
          id="relations-generation-form"
          phx-submit="generate_relations"
          class="space-y-4"
        >
          <div>
            <label class="label">
              <span class="label-text">{gettext("Prompt (editable)")}</span>
            </label>
            <textarea
              name="prompt"
              phx-change="update_relations_prompt"
              phx-debounce="300"
              class="textarea textarea-bordered w-full h-48 font-mono text-sm"
            >{@relations_prompt}</textarea>
            <p class="text-xs text-base-content/50 mt-1">
              {gettext("Edit the prompt before generating. The word details are pre-filled.")}
            </p>
          </div>

          <%!-- Error display --%>
          <%= if @relations_error do %>
            <div class="alert alert-error alert-soft">
              <.icon name="hero-exclamation-triangle" class="w-5 h-5" />
              <span>{@relations_error}</span>
            </div>
          <% end %>

          <div class="modal-action flex-col sm:flex-row gap-2">
            <button
              type="button"
              phx-click="close_relations_modal"
              class="btn btn-ghost w-full sm:w-auto"
            >
              {gettext("Close")}
            </button>
            <button
              type="submit"
              class="btn btn-secondary w-full sm:w-auto"
              disabled={@relations_loading}
            >
              <%= if @relations_loading do %>
                <span class="loading loading-spinner loading-sm mr-2"></span>
                {gettext("Generating...")}
              <% else %>
                <.icon name="hero-sparkles" class="w-4 h-4 mr-2" />
                {gettext("Generate")}
              <% end %>
            </button>
          </div>
        </.form>

        <%!-- Pending relations list (outside the generation form) --%>
        <%= if @pending_relations != [] do %>
          <div class="border border-base-300 rounded-lg overflow-hidden">
            <div class="bg-base-200 px-4 py-2 font-medium">
              {gettext("Pending suggestions — approve or reject each one")}
            </div>
            <div class="divide-y divide-base-300">
              <%= for relation <- @pending_relations do %>
                <div class="p-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                  <div class="flex items-center gap-3">
                    <span class={[
                      "badge badge-sm",
                      relation.relation_type == :synonym && "badge-success",
                      relation.relation_type == :antonym && "badge-error",
                      relation.relation_type == :expression && "badge-info"
                    ]}>
                      {relation.relation_type}
                    </span>
                    <%= if relation.related_word do %>
                      <.link
                        navigate={~p"/admin/words/#{relation.related_word.id}/edit"}
                        class="font-medium hover:text-primary"
                      >
                        {relation.related_word.text}
                      </.link>
                      <span class="text-sm text-secondary">{relation.related_word.reading}</span>
                      <span class="text-xs text-base-content/50">
                        {relation.related_word.meaning}
                      </span>
                    <% else %>
                      <span class="font-medium">{relation.expression_text}</span>
                      <span class="text-sm text-secondary">{gettext("(not in database)")}</span>
                    <% end %>
                  </div>

                  <div class="flex gap-2">
                    <button
                      type="button"
                      phx-click="approve_relation"
                      phx-value-relation_id={relation.id}
                      class="btn btn-sm btn-success"
                    >
                      <.icon name="hero-check" class="w-4 h-4 mr-1" />
                      {gettext("Approve")}
                    </button>
                    <button
                      type="button"
                      phx-click="reject_relation"
                      phx-value-relation_id={relation.id}
                      class="btn btn-sm btn-error btn-outline"
                    >
                      <.icon name="hero-x-mark" class="w-4 h-4 mr-1" />
                      {gettext("Reject")}
                    </button>
                  </div>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
    <div class="modal-backdrop" phx-click="close_relations_modal"></div>
  </div>
<% end %>
