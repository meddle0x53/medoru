<Layouts.app flash={@flash} current_scope={@current_scope} socket={@socket}>
  <div class="max-w-4xl mx-auto px-4 py-8">
    <%!-- Back Link --%>
    <.link
      navigate={~p"/katakana/bulgarian"}
      class="inline-flex items-center gap-2 text-secondary hover:text-primary mb-6 transition-colors"
    >
      <.icon name="hero-arrow-left" class="w-4 h-4" />
      {gettext("Back to Bulgarian Katakana")}
    </.link>

    <%!-- Main Letter Card --%>
    <div class="bg-base-100 rounded-2xl shadow-sm border border-base-300 overflow-hidden mb-8">
      <div class="p-8">
        <div class="flex flex-col md:flex-row gap-8">
          <%!-- Large Letter Display --%>
          <div class="flex-shrink-0">
            <div class="w-32 h-32 md:w-40 md:h-40 bg-base-200/70 rounded-2xl flex items-center justify-center border border-base-300 shadow-inner">
              <span class="text-7xl md:text-8xl font-medium text-base-content">
                {@entry.letter}
              </span>
            </div>
          </div>

          <%!-- Info Section --%>
          <div class="flex-1">
            <%= if @entry.note do %>
              <div class="mb-4">
                <span class="bg-amber-100 text-amber-700 dark:bg-amber-900/30 dark:text-amber-300 px-3 py-1 rounded-full text-sm font-medium">
                  {@entry.note}
                </span>
              </div>
            <% end %>

            <h1 class="text-2xl font-bold text-base-content mb-6">
              {gettext("Readings")}
            </h1>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
              <div class="bg-base-200/50 rounded-xl p-4 text-center">
                <div class="text-xs text-secondary uppercase tracking-wider mb-1">
                  {gettext("Katakana")}
                </div>
                <div class="text-3xl font-medium text-base-content">
                  {@entry.katakana}
                </div>
              </div>
              <div class="bg-base-200/50 rounded-xl p-4 text-center">
                <div class="text-xs text-secondary uppercase tracking-wider mb-1">
                  {gettext("Hiragana")}
                </div>
                <div class="text-3xl font-medium text-base-content">
                  {@entry.hiragana}
                </div>
              </div>
              <div class="bg-base-200/50 rounded-xl p-4 text-center">
                <div class="text-xs text-secondary uppercase tracking-wider mb-1">
                  {gettext("Latin")}
                </div>
                <div class="text-3xl font-medium text-base-content">
                  {@entry.latin}
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <%!-- Example Words --%>
    <div class="bg-base-100 rounded-2xl shadow-sm border border-base-300 overflow-hidden mb-8">
      <div class="bg-base-200/50 px-6 py-3 border-b border-base-300">
        <span class="text-sm font-semibold text-secondary uppercase tracking-wider">
          {gettext("Example Words")}
        </span>
      </div>
      <div class="divide-y divide-base-200">
        <%= for word <- @entry.words do %>
          <div class="p-4 sm:p-6 flex flex-col sm:flex-row sm:items-center gap-3 sm:gap-6">
            <div class="flex-1 min-w-0">
              <div class="flex flex-wrap items-center gap-2 mb-1">
                <span class="text-xl font-medium text-base-content">
                  {highlight_letter(word.bulgarian, @entry.letter)}
                </span>
                <span class="text-lg text-secondary">
                  {word.katakana}
                </span>
              </div>
              <%= if word.word_id do %>
                <.link
                  navigate={~p"/words/#{word.word_text}"}
                  class="text-primary hover:text-primary/80 transition-colors"
                >
                  {word.meaning} →
                </.link>
              <% else %>
                <span class="text-secondary">
                  {word.meaning}
                </span>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </div>

    <%!-- Navigation --%>
    <div class="flex items-center justify-between">
      <div>
        <%= if @prev_entry do %>
          <.link
            navigate={~p"/katakana/bulgarian/#{@prev_entry.letter}"}
            class="inline-flex items-center gap-2 text-secondary hover:text-primary font-medium transition-colors"
          >
            <.icon name="hero-arrow-left" class="w-4 h-4" />
            <span class="text-2xl">{@prev_entry.letter}</span>
            <span class="text-sm">{@prev_entry.katakana}</span>
          </.link>
        <% else %>
          <span class="text-secondary/40 inline-flex items-center gap-2">
            <.icon name="hero-arrow-left" class="w-4 h-4" /> {gettext("Previous")}
          </span>
        <% end %>
      </div>

      <div>
        <%= if @next_entry do %>
          <.link
            navigate={~p"/katakana/bulgarian/#{@next_entry.letter}"}
            class="inline-flex items-center gap-2 text-secondary hover:text-primary font-medium transition-colors"
          >
            <span class="text-sm">{@next_entry.katakana}</span>
            <span class="text-2xl">{@next_entry.letter}</span>
            <.icon name="hero-arrow-right" class="w-4 h-4" />
          </.link>
        <% else %>
          <span class="text-secondary/40 inline-flex items-center gap-2">
            {gettext("Next")} <.icon name="hero-arrow-right" class="w-4 h-4" />
          </span>
        <% end %>
      </div>
    </div>
  </div>
</Layouts.app>
