<Layouts.app flash={@flash} current_scope={@current_scope} socket={@socket}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <%!-- Welcome Header --%>
    <div class="mb-8">
      <h1 class="text-3xl font-bold text-base-content">
        {gettext("Welcome back")}, {@profile.display_name || @user.name || @user.email}!
      </h1>
      <p class="mt-2 text-secondary">
        {gettext("Continue your Japanese learning journey.")}
      </p>
    </div>

    <%!-- Daily Goal Card --%>
    <div class="card bg-gradient-to-br from-primary/10 to-secondary/10 border border-primary/20 mb-8">
      <div class="card-body">
        <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4">
          <div class="flex items-center gap-4">
            <% completed = (@challenge_stats && @challenge_stats.completed_count) || 0 %>
            <% total = (@challenge_stats && @challenge_stats.total_challenges) || 3 %>
            <% all_completed = completed >= total %>
            <div class={[
              "w-16 h-16 rounded-full flex items-center justify-center",
              if(all_completed, do: "bg-success/20", else: "bg-warning/20")
            ]}>
              <.icon
                name={if all_completed, do: "hero-check-circle", else: "hero-fire"}
                class={[
                  "w-8 h-8",
                  if(all_completed, do: "text-success", else: "text-warning")
                ]}
              />
            </div>
            <div>
              <h2 class="text-xl font-bold text-base-content">
                <%= if all_completed do %>
                  {gettext("Daily Goal Completed!")} 🎉
                <% else %>
                  {gettext("Keep Your Streak Going!")}
                <% end %>
              </h2>
              <p class="text-base-content/70">
                {gettext("Complete any challenge to keep your streak going!")}
              </p>
            </div>
          </div>

          <.link
            navigate={~p"/daily-challenges"}
            class={[
              "btn btn-lg h-auto py-3 px-6 min-w-fit whitespace-normal text-center leading-tight w-full sm:w-auto",
              if(all_completed, do: "btn-outline btn-success", else: "btn-primary")
            ]}
          >
            <%= if completed > 0 do %>
              <.icon name="hero-check" class="w-5 h-5 mr-2 flex-shrink-0" /> {completed} / {total} {gettext("Completed")}
            <% else %>
              <.icon name="hero-play" class="w-5 h-5 mr-2 flex-shrink-0" /> {gettext(
                "Daily Challenges"
              )}
            <% end %>
          </.link>
        </div>
      </div>
    </div>

    <%!-- Stats Grid --%>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-6 mb-8">
      <.stat_card
        label={gettext("Level")}
        value={@xp_progress.current_level}
        icon="sparkles"
        color="purple"
      />
      <.stat_card
        label={gettext("Current Streak")}
        value={(@daily_stats && @daily_stats.current_streak) || 0}
        icon="fire"
        color="orange"
      />
      <.stat_card
        label={gettext("Longest Streak")}
        value={(@daily_stats && @daily_stats.longest_streak) || 0}
        icon="trophy"
        color="yellow"
      />
      <.link navigate={~p"/users/#{@user.id}/kanji"} class="block">
        <.stat_card
          label={gettext("Kanji Learned")}
          value={@stats.total_kanji_learned}
          icon="book-open"
          color="blue"
        />
      </.link>
      <.link navigate={~p"/users/#{@user.id}/words"} class="block">
        <.stat_card
          label={gettext("Words Learned")}
          value={@stats.total_words_learned}
          icon="document-text"
          color="green"
        />
      </.link>
    </div>

    <%!-- XP Progress Bar --%>
    <div class="card bg-base-100 border border-base-300 mb-8">
      <div class="card-body py-4">
        <div class="flex items-center justify-between mb-2">
          <span class="text-sm font-medium text-base-content">
            {gettext("Level %{level} Progress", level: @xp_progress.current_level)}
          </span>
          <span class="text-sm text-base-content/60">
            {@xp_progress.xp_into_level} / {@xp_progress.xp_needed_for_next} {gettext("XP")}
          </span>
        </div>
        <progress
          value={@xp_progress.progress_percent}
          max="100"
          class="progress progress-primary w-full h-2"
        >
          {@xp_progress.progress_percent}%
        </progress>
      </div>
    </div>

    <%!-- Classrooms Section --%>
    <div class="card bg-gradient-to-br from-indigo-500/10 to-purple-500/10 border border-indigo-500/20 mb-8">
      <div class="card-body">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
          <div class="flex items-center gap-4">
            <div class="w-14 h-14 rounded-2xl bg-indigo-500/20 flex items-center justify-center shrink-0">
              <.icon name="hero-users" class="w-7 h-7 text-indigo-600 dark:text-indigo-400" />
            </div>
            <div>
              <h2 class="text-xl font-bold text-base-content">
                {gettext("Your Classrooms")}
              </h2>
              <p class="text-base-content/70">
                {gettext(
                  "Join or create classrooms to learn with others and compete on leaderboards."
                )}
              </p>
            </div>
          </div>

          <.link
            navigate={~p"/classrooms"}
            class="btn btn-primary h-auto py-3 px-6 min-h-[48px] whitespace-nowrap"
          >
            <.icon name="hero-arrow-right" class="w-5 h-5 mr-2" />
            {gettext("Go to Classrooms")}
          </.link>
        </div>
      </div>
    </div>

    <%!-- Quick Actions --%>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-2 xl:grid-cols-3 gap-4 sm:gap-6">
      <.action_card
        title={gettext("Continue Learning")}
        description={gettext("Pick up where you left off with your lessons.")}
        button_text={gettext("View Lessons")}
        button_link={~p"/lessons"}
        icon="academic-cap"
      />
      <.action_card
        title={gettext("Browse Kanji")}
        description={gettext("Explore the kanji database organized by JLPT level.")}
        button_text={gettext("Browse Kanji")}
        button_link={~p"/kanji"}
        icon="book-open"
      />
      <.action_card
        title={gettext("Browse Vocabulary")}
        description={gettext("Learn Japanese words and see their kanji breakdown.")}
        button_text={gettext("Browse Words")}
        button_link={~p"/words"}
        icon="document-text"
      />
    </div>
  </div>
</Layouts.app>
