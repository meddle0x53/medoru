<Layouts.app flash={@flash} current_scope={@current_scope} socket={@socket}>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <%!-- Back Link --%>
    <.link
      navigate={~p"/grammars"}
      class="text-secondary hover:text-primary text-sm flex items-center gap-1 mb-6 transition-colors"
    >
      <.icon name="hero-arrow-left" class="w-4 h-4" />
      {gettext("Back to Grammar")}
    </.link>

    <%!-- Header --%>
    <div class="mb-8">
      <div class="flex items-start justify-between gap-4">
        <h1 class="text-3xl sm:text-4xl font-bold text-base-content">
          {@grammar_definition.title}
        </h1>
        <%= if @grammar_definition.jlpt_level do %>
          <span class={["badge badge-lg", level_badge_color(@grammar_definition.jlpt_level)]}>
            N{@grammar_definition.jlpt_level}
          </span>
        <% end %>
      </div>
    </div>

    <%!-- Mark as Learned --%>
    <%= if @current_scope && @current_scope.current_user do %>
      <div class="mb-6">
        <%= if @grammar_learned do %>
          <button
            phx-click="unlearn_grammar"
            data-confirm={
              gettext("Are you sure? This will remove '%{grammar}' from your learned grammar.",
                grammar: @grammar_definition.title
              )
            }
            class="w-full bg-green-100 hover:bg-red-100 dark:bg-green-900/30 dark:hover:bg-red-900/30 text-green-700 hover:text-red-700 dark:text-green-300 dark:hover:text-red-300 px-6 py-4 rounded-xl font-medium transition-all duration-200 active:scale-[0.98] flex items-center justify-center gap-2"
          >
            <.icon name="hero-check-circle" class="w-5 h-5" /> {gettext(
              "Learned (click to unlearn)"
            )}
          </button>
        <% else %>
          <button
            phx-click="mark_grammar_learned"
            class="w-full bg-primary hover:bg-primary/90 text-primary-content px-6 py-4 rounded-xl font-medium transition-all shadow-sm hover:shadow active:scale-[0.98] flex items-center justify-center gap-2"
          >
            <.icon name="hero-check" class="w-5 h-5" /> {gettext("Mark as Learned")}
          </button>
        <% end %>
      </div>
    <% end %>

    <%!-- Pattern Display --%>
    <div class="card bg-base-100 border border-base-300 shadow-sm mb-6">
      <div class="card-body p-4 sm:p-6">
        <h2 class="text-lg font-semibold text-base-content mb-4">
          {gettext("Pattern")}
        </h2>
        <div class="flex flex-wrap gap-2 items-center">
          <%= for element <- @grammar_definition.pattern_elements do %>
            <%= case element["type"] do %>
              <% "literal" -> %>
                <span class="px-3 py-1.5 bg-base-200 rounded-lg text-base-content font-medium text-lg">
                  {element["text"] || ""}
                </span>
              <% "word_slot" -> %>
                <span class="px-3 py-1.5 bg-primary/10 rounded-lg text-primary font-medium border border-primary/30 text-lg">
                  {element["word_type"] || gettext("word")}
                  <%= if element["forms"] && length(element["forms"]) > 0 do %>
                    <span class="text-sm opacity-80">
                      ({Enum.join(element["forms"], ", ")})
                    </span>
                  <% end %>
                </span>
              <% "word_class" -> %>
                <span class="px-3 py-1.5 bg-secondary/10 rounded-lg text-secondary font-medium border border-secondary/30 text-lg">
                  {element["word_class"] || gettext("Class")}
                </span>
              <% "particle" -> %>
                <span class="px-3 py-1.5 bg-secondary/10 rounded-lg text-secondary font-medium border border-secondary/30 text-lg">
                  {element["text"] || gettext("particle")}
                </span>
              <% _ -> %>
                <span class="px-3 py-1.5 bg-base-200 rounded-lg text-base-content text-lg">
                  {element["type"]}
                </span>
            <% end %>
          <% end %>
        </div>
      </div>
    </div>

    <%!-- Description --%>
    <%= if @grammar_definition.description do %>
      <div class="card bg-base-100 border border-base-300 shadow-sm mb-6">
        <div class="card-body p-4 sm:p-6">
          <h2 class="text-lg font-semibold text-base-content mb-4">
            {gettext("Explanation")}
          </h2>
          <div class="prose prose-sm dark:prose-invert max-w-none">
            {Phoenix.HTML.raw(
              render_description(localized_description(@grammar_definition, @locale))
            )}
          </div>
        </div>
      </div>
    <% end %>

    <%!-- Examples --%>
    <%= if @grammar_definition.examples != [] do %>
      <div class="card bg-base-100 border border-base-300 shadow-sm mb-6">
        <div class="card-body p-4 sm:p-6">
          <h2 class="text-lg font-semibold text-base-content mb-4">
            {gettext("Examples")}
          </h2>
          <div class="space-y-4">
            <%= for {example, index} <- Enum.with_index(@grammar_definition.examples) do %>
              <div class="p-4 bg-base-200/50 rounded-xl border border-base-200">
                <div class="flex items-start gap-3">
                  <span class="flex-shrink-0 w-7 h-7 bg-primary/10 text-primary rounded-full flex items-center justify-center text-sm font-semibold">
                    {index + 1}
                  </span>
                  <div class="flex-1 min-w-0">
                    <p class="text-lg font-medium text-base-content">
                      {example["sentence"]}
                    </p>
                    <p class="text-sm text-secondary mt-1">
                      {example["reading"]}
                    </p>
                    <p class="text-sm text-base-content/80 mt-2">
                      {localized_example_meaning(example, @locale)}
                    </p>
                  </div>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>

    <%!-- Try Your Own Example --%>
    <div class="card bg-base-100 border border-base-300 shadow-sm mb-6">
      <div class="card-body p-4 sm:p-6">
        <h2 class="text-lg font-semibold text-base-content mb-4">
          {gettext("Try Your Own Example")}
        </h2>
        <p class="text-sm text-secondary mb-4">
          {gettext("Write a sentence that follows this grammar pattern and validate it.")}
        </p>

        <form phx-submit="validate_sentence" class="space-y-4">
          <div>
            <input
              type="text"
              name="sentence"
              value={@user_sentence}
              placeholder={gettext("Type your Japanese sentence here...")}
              class="input input-bordered w-full"
              phx-change="update_sentence"
              phx-debounce="200"
            />
          </div>

          <%= if @validation_result do %>
            <div class={[
              "rounded-lg p-4",
              if(@validation_result.valid,
                do: "bg-success/10 border border-success/30 text-success",
                else: "bg-error/10 border border-error/30 text-error"
              )
            ]}>
              <div class="flex items-center gap-2">
                <.icon
                  name={
                    if @validation_result.valid, do: "hero-check-circle", else: "hero-x-circle"
                  }
                  class="w-5 h-5 shrink-0"
                />
                <p class="text-sm font-medium">{@validation_result.message}</p>
              </div>
            </div>
          <% end %>

          <button type="submit" class="btn btn-primary min-h-[44px] touch-target">
            <.icon name="hero-check" class="w-4 h-4 mr-2" />
            {gettext("Validate")}
          </button>
        </form>
      </div>
    </div>
  </div>
</Layouts.app>
