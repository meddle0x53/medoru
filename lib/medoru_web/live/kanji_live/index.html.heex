<Layouts.app flash={@flash} current_scope={@current_scope} socket={@socket}>
  <div class="max-w-6xl mx-auto px-4 py-8">
    <%!-- Header --%>
    <div class="mb-8">
      <h1 class="text-3xl font-bold text-base-content mb-2">{gettext("Kanji Browser")}</h1>
      <p class="text-secondary">
        {gettext(
          "Browse and learn Japanese kanji organized by JLPT level or Japanese school grade"
        )}
      </p>
    </div>

    <%!-- Search Bar --%>
    <div class="mb-6">
      <form phx-submit="search" class="flex gap-2">
        <div class="relative flex-1 min-w-0">
          <input
            type="text"
            name="query"
            value={@search_query}
            placeholder={gettext("Search kanji by character, meaning, or reading...")}
            class="w-full px-4 py-2.5 pl-10 bg-base-100 border border-base-300 rounded-xl
                   text-base-content placeholder:text-secondary/50
                   focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary"
            phx-keydown={if @search_query != "", do: "clear_search"}
            phx-key="Escape"
          />
          <.icon
            name="hero-magnifying-glass"
            class="w-5 h-5 absolute left-3 top-1/2 -translate-y-1/2 text-secondary/50"
          />
        </div>
        <button
          type="submit"
          class="px-5 py-2.5 bg-primary text-primary-content rounded-xl font-medium
                 hover:bg-primary/90 transition-colors shrink-0"
        >
          {gettext("Search")}
        </button>
        <%= if @search_query != "" do %>
          <button
            type="button"
            phx-click="clear_search"
            class="px-4 py-2.5 bg-base-200 text-secondary rounded-xl font-medium
                   hover:bg-base-300 transition-colors shrink-0"
          >
            {gettext("Clear")}
          </button>
        <% end %>
      </form>
    </div>

    <%!-- Kana Links --%>
    <div class="flex gap-2 mb-6">
      <.link
        navigate={~p"/hiragana"}
        class="px-5 py-2.5 rounded-xl font-medium bg-pink-100 text-pink-700 hover:bg-pink-200 dark:bg-pink-900/30 dark:text-pink-300 dark:hover:bg-pink-900/50 transition-all duration-200"
      >
        {gettext("Hiragana")} あ
      </.link>
      <.link
        navigate={~p"/katakana"}
        class="px-5 py-2.5 rounded-xl font-medium bg-blue-100 text-blue-700 hover:bg-blue-200 dark:bg-blue-900/30 dark:text-blue-300 dark:hover:bg-blue-900/50 transition-all duration-200"
      >
        {gettext("Katakana")} ア
      </.link>
      <.link
        navigate={~p"/radicals"}
        class="px-5 py-2.5 rounded-xl font-medium bg-amber-100 text-amber-700 hover:bg-amber-200 dark:bg-amber-900/30 dark:text-amber-300 dark:hover:bg-amber-900/50 transition-all duration-200"
      >
        {gettext("Radicals")} 部
      </.link>
    </div>

    <%!-- JLPT Level Selector --%>
    <div class="mb-2">
      <span class="text-xs font-semibold text-secondary uppercase tracking-wider mb-2 block">
        {gettext("JLPT Level")}
      </span>
      <div class="flex flex-wrap gap-2">
        <%= for level <- [5, 4, 3, 2, 1] do %>
          <.link
            patch={~p"/kanji?level=#{level}"}
            class={[
              "px-5 py-2.5 rounded-xl font-medium transition-all duration-200",
              if(@filter_type == :jlpt && @jlpt_level == level,
                do: "bg-primary text-primary-content shadow-md",
                else: "bg-base-200 text-secondary hover:bg-base-300 hover:text-primary"
              )
            ]}
          >
            N{level}
          </.link>
        <% end %>
      </div>
    </div>

    <%!-- School Level Selector (SL1-SL6) --%>
    <div class="mb-8">
      <span class="text-xs font-semibold text-secondary uppercase tracking-wider mb-2 block">
        {gettext("Japanese School Level")}
      </span>
      <div class="flex flex-wrap gap-2">
        <%= for level <- 1..6 do %>
          <.link
            patch={~p"/kanji?sl=#{level}"}
            class={[
              "px-4 py-2 rounded-xl font-medium transition-all duration-200",
              if(@filter_type == :school && @school_level == level,
                do: "bg-secondary text-secondary-content shadow-md",
                else: "bg-base-200 text-secondary hover:bg-base-300 hover:text-secondary"
              )
            ]}
          >
            SL{level}
          </.link>
        <% end %>
      </div>
    </div>

    <%!-- Stats --%>
    <div class="mb-6 flex items-center gap-3 text-sm text-secondary flex-wrap">
      <span class="bg-base-200 px-3 py-1.5 rounded-full">
        {length(@kanji_list)} {gettext("characters")}
      </span>
      <%= cond do %>
        <% @filter_type == :search -> %>
          <span class="bg-primary/10 text-primary px-3 py-1.5 rounded-full">
            {gettext("Search results for")} "{@search_query}"
          </span>
        <% @filter_type == :jlpt -> %>
          <span class="bg-base-200 px-3 py-1.5 rounded-full">
            JLPT N{@jlpt_level}
          </span>
        <% @filter_type == :school -> %>
          <span class="bg-base-200 px-3 py-1.5 rounded-full">
            {gettext("School Level")} SL{@school_level}
            <%= if @school_level == 1 do %>
              (1st grade)
            <% else %>
              ({@school_level}th grade)
            <% end %>
          </span>
        <% true -> %>
      <% end %>
    </div>

    <%!-- Kanji Grid --%>
    <div class="grid grid-cols-5 sm:grid-cols-6 md:grid-cols-7 lg:grid-cols-8 xl:grid-cols-10 gap-3">
      <%= for kanji <- @kanji_list do %>
        <% is_learned = kanji.id in @learned_kanji_ids %>
        <.link
          navigate={kanji_path(kanji)}
          class="group"
        >
          <div class={[
            "aspect-square rounded-xl flex items-center justify-center shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all duration-200 border",
            if is_learned do
              "bg-success/10 dark:bg-success/20 border-success/40 dark:border-success/30 hover:border-success/60 dark:hover:border-success/50"
            else
              "bg-base-100 border-base-300 hover:border-primary/30"
            end
          ]}>
            <span class={[
              "text-3xl font-medium transition-colors",
              if is_learned do
                "text-success dark:text-success group-hover:text-success/80 dark:group-hover:text-success/80"
              else
                "text-base-content group-hover:text-primary"
              end
            ]}>
              {kanji.character}
            </span>
          </div>
          <div class="mt-1.5 text-center">
            <span class="text-xs text-secondary/70 line-clamp-1 px-1">
              {localized_kanji_meaning(kanji, @locale)}
            </span>
          </div>
        </.link>
      <% end %>
    </div>

    <%= if @kanji_list == [] do %>
      <div class="text-center py-16">
        <div class="text-6xl mb-4">📚</div>
        <h3 class="text-lg font-medium text-base-content mb-2">
          <%= if @filter_type == :search do %>
            {gettext("No kanji found for")} "{@search_query}"
          <% else %>
            {gettext("No kanji found")}
          <% end %>
        </h3>
        <p class="text-secondary">
          <%= if @filter_type == :search do %>
            {gettext("Try a different search term or browse by level instead.")}
          <% else %>
            {gettext("This level doesn't have any kanji data yet.")}
          <% end %>
        </p>
      </div>
    <% end %>
  </div>
</Layouts.app>
