<Layouts.app flash={@flash} current_scope={@current_scope} socket={@socket}>
  <div class="max-w-6xl mx-auto px-4 py-8">
    <%!-- Header --%>
    <div class="mb-8">
      <div class="flex items-center gap-3 mb-2">
        <.link
          navigate={~p"/users/#{@user.id}"}
          class="text-secondary hover:text-primary transition-colors"
        >
          <.icon name="hero-arrow-left" class="w-5 h-5" />
        </.link>
        <h1 class="text-3xl font-bold text-base-content">
          {gettext("%{name}'s Learned Grammar", name: @user.name || @user.email)}
        </h1>
      </div>
      <p class="text-secondary">
        {gettext("All %{count} grammar points that have been learned", count: @total_count)}
      </p>
    </div>

    <%!-- Stats --%>
    <div class="mb-6 flex flex-wrap items-center gap-3 text-sm text-secondary">
      <span class="bg-base-200 px-3 py-1.5 rounded-full">
        {@total_count} {gettext("grammar learned")}
      </span>
      <span class="bg-base-200 px-3 py-1.5 rounded-full">
        {gettext("Page %{page} of %{total}", page: @page, total: @total_pages)}
      </span>
    </div>

    <%!-- Grammar Grid --%>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      <%= for grammar <- @grammar_definitions do %>
        <.link
          navigate={~p"/grammars/#{grammar.slug}"}
          class="group block"
        >
          <div class="bg-amber-50/60 dark:bg-amber-900/20 border border-amber-200/60 dark:border-amber-800/40 rounded-xl p-5
                      shadow-sm hover:shadow-md hover:border-amber-300/60 dark:hover:border-amber-700/50 hover:-translate-y-0.5 transition-all duration-200">
            <div class="flex items-start justify-between mb-2">
              <h3 class="text-lg font-semibold text-base-content group-hover:text-amber-600 dark:group-hover:text-amber-400 transition-colors">
                {grammar.title}
              </h3>
              <%= if grammar.jlpt_level do %>
                <span class={["badge badge-sm", level_badge_color(grammar.jlpt_level)]}>
                  N{grammar.jlpt_level}
                </span>
              <% end %>
            </div>

            <%!-- Pattern Preview --%>
            <div class="flex flex-wrap gap-1.5 items-center mb-3">
              <%= for element <- Enum.take(grammar.pattern_elements, 6) do %>
                <%= case element["type"] do %>
                  <% "literal" -> %>
                    <span class="px-2 py-0.5 bg-base-200 rounded text-sm text-base-content">
                      {element["text"] || ""}
                    </span>
                  <% "word_slot" -> %>
                    <span class="px-2 py-0.5 bg-primary/10 rounded text-sm text-primary border border-primary/20">
                      <%= if element["word_class"] do %>
                        {element["word_class"]}
                      <% else %>
                        {element["word_type"] || gettext("word")}
                      <% end %>
                    </span>
                  <% "particle" -> %>
                    <span class="px-2 py-0.5 bg-secondary/10 rounded text-sm text-secondary border border-secondary/20">
                      {element["text"] || gettext("particle")}
                    </span>
                  <% _ -> %>
                    <span class="px-2 py-0.5 bg-base-200 rounded text-sm text-base-content">
                      {element["type"]}
                    </span>
                <% end %>
              <% end %>
              <%= if length(grammar.pattern_elements) > 6 do %>
                <span class="text-xs text-secondary">…</span>
              <% end %>
            </div>

            <%!-- Description --%>
            <p class="text-secondary text-sm line-clamp-2">
              {localized_description(grammar, @locale)}
            </p>
          </div>
        </.link>
      <% end %>
    </div>

    <%!-- Empty State --%>
    <%= if @grammar_definitions == [] do %>
      <div class="text-center py-16">
        <div class="text-6xl mb-4">📝</div>
        <h3 class="text-lg font-medium text-base-content mb-2">
          {gettext("No grammar learned yet")}
        </h3>
        <p class="text-secondary mb-6">
          {gettext("Start learning by browsing grammar definitions and marking them as learned.")}
        </p>
        <.link
          navigate={~p"/grammars"}
          class="inline-flex items-center px-6 py-3 bg-primary text-primary-content rounded-xl font-medium hover:bg-primary/90 transition-colors"
        >
          <.icon name="hero-book-open" class="w-5 h-5 mr-2" />
          {gettext("Browse Grammar")}
        </.link>
      </div>
    <% end %>

    <%!-- Pagination --%>
    <%= if @total_pages > 1 do %>
      <div class="mt-8 flex justify-center">
        <div class="flex items-center gap-2">
          <%= if @page > 1 do %>
            <button
              phx-click="change_page"
              phx-value-page={@page - 1}
              class="px-4 py-2 bg-base-200 text-secondary rounded-lg hover:bg-base-300 transition-colors"
            >
              ← {gettext("Prev")}
            </button>
          <% else %>
            <span class="px-4 py-2 bg-base-200/50 text-secondary/40 rounded-lg cursor-not-allowed">
              ← {gettext("Prev")}
            </span>
          <% end %>

          <div class="flex items-center gap-1">
            <%= for p <- max(1, @page - 2)..min(@total_pages, @page + 2) do %>
              <%= if p == @page do %>
                <span class="px-3 py-2 bg-primary text-primary-content rounded-lg font-medium">
                  {p}
                </span>
              <% else %>
                <button
                  phx-click="change_page"
                  phx-value-page={p}
                  class="px-3 py-2 text-secondary hover:bg-base-200 rounded-lg transition-colors"
                >
                  {p}
                </button>
              <% end %>
            <% end %>
          </div>

          <%= if @page < @total_pages do %>
            <button
              phx-click="change_page"
              phx-value-page={@page + 1}
              class="px-4 py-2 bg-base-200 text-secondary rounded-lg hover:bg-base-300 transition-colors"
            >
              {gettext("Next")} →
            </button>
          <% else %>
            <span class="px-4 py-2 bg-base-200/50 text-secondary/40 rounded-lg cursor-not-allowed">
              {gettext("Next")} →
            </span>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</Layouts.app>
