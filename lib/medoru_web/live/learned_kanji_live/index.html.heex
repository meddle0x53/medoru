<Layouts.app flash={@flash} current_scope={@current_scope} socket={@socket}>
  <div class="max-w-6xl mx-auto px-4 py-8">
    <%!-- Header --%>
    <div class="mb-6">
      <div class="flex items-center gap-3 mb-2">
        <.link
          navigate={~p"/users/#{@user.id}"}
          class="text-secondary hover:text-primary transition-colors"
        >
          <.icon name="hero-arrow-left" class="w-5 h-5" />
        </.link>
        <h1 class="text-3xl font-bold text-base-content">
          {gettext("%{name}'s Learned Kanji", name: @user.name || @user.email)}
        </h1>
      </div>
      <p class="text-secondary">
        {gettext("All %{count} kanji that have been learned", count: @total_count)}
      </p>
    </div>

    <%!-- Search Bar --%>
    <div class="mb-4">
      <form id="search-form" phx-submit="search" class="flex flex-col sm:flex-row gap-2">
        <div class="relative flex-1 min-w-0">
          <input
            type="text"
            name="query"
            value={@search_query}
            placeholder={gettext("Search learned kanji by character, meaning, or reading...")}
            class="w-full px-4 py-2.5 pl-10 bg-base-100 border border-base-300 rounded-xl
                   text-base-content placeholder:text-secondary/50
                   focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary"
            phx-keydown={if @search_query != "", do: "clear_search"}
            phx-key="Escape"
          />
          <.icon
            name="hero-magnifying-glass"
            class="w-5 h-5 absolute left-3 top-1/2 -translate-y-1/2 text-secondary/50"
          />
        </div>
        <button
          type="submit"
          class="px-5 py-2.5 bg-primary text-primary-content rounded-xl font-medium
                 hover:bg-primary/90 transition-colors shrink-0"
        >
          {gettext("Search")}
        </button>
        <%= if @search_query != "" do %>
          <button
            type="button"
            phx-click="clear_search"
            class="px-4 py-2.5 bg-base-200 text-secondary rounded-xl font-medium
                   hover:bg-base-300 transition-colors shrink-0"
          >
            {gettext("Clear")}
          </button>
        <% end %>
      </form>
    </div>

    <%!-- Filters & Sort --%>
    <div class="mb-4 space-y-3">
      <%!-- Sort dropdown --%>
      <div class="flex flex-col sm:flex-row sm:items-center gap-2">
        <label for="sort-by" class="text-sm text-secondary shrink-0">
          {gettext("Sort by")}:
        </label>
        <form id="sort-form" phx-change="change_sort" class="flex-1 min-w-0">
          <select
            id="sort-by"
            name="sort"
            class="w-full sm:w-auto px-3 py-2 bg-base-100 border border-base-300 rounded-lg
                   text-base-content focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary"
          >
            <option value="learned_desc" selected={@sort_by == :learned_desc}>
              {gettext("Recently learned")}
            </option>
            <option value="learned_asc" selected={@sort_by == :learned_asc}>
              {gettext("Oldest learned")}
            </option>
            <option value="character_asc" selected={@sort_by == :character_asc}>
              {gettext("Character")}
            </option>
            <option value="jlpt_asc" selected={@sort_by == :jlpt_asc}>
              {gettext("JLPT level")}
            </option>
            <option value="stroke_asc" selected={@sort_by == :stroke_asc}>
              {gettext("Stroke count")}
            </option>
            <option value="known_score_desc" selected={@sort_by == :known_score_desc}>
              {gettext("Known score")}
            </option>
            <option value="frequency_asc" selected={@sort_by == :frequency_asc}>
              {gettext("Frequency")}
            </option>
          </select>
        </form>
      </div>

      <%!-- JLPT Level Selector --%>
      <div>
        <span class="text-xs font-semibold text-secondary uppercase tracking-wider mb-2 block">
          {gettext("JLPT Level")}
        </span>
        <div class="flex flex-wrap gap-2">
          <%= for level <- [5, 4, 3, 2, 1] do %>
            <.link
              patch={~p"/users/#{@user.id}/kanji?level=#{level}"}
              class={[
                "px-4 py-2 rounded-xl font-medium transition-all duration-200",
                if(@filter_type == :jlpt && @jlpt_level == level,
                  do: "bg-primary text-primary-content shadow-md",
                  else: "bg-base-200 text-secondary hover:bg-base-300 hover:text-primary"
                )
              ]}
            >
              N{level}
            </.link>
          <% end %>
          <%= if @filter_type == :jlpt do %>
            <.link
              patch={~p"/users/#{@user.id}/kanji"}
              class="px-4 py-2 rounded-xl font-medium bg-base-200 text-secondary hover:bg-base-300 transition-colors"
            >
              {gettext("All levels")}
            </.link>
          <% end %>
        </div>
      </div>

      <%!-- School Level Selector --%>
      <div>
        <span class="text-xs font-semibold text-secondary uppercase tracking-wider mb-2 block">
          {gettext("Japanese School Level")}
        </span>
        <div class="flex flex-wrap gap-2">
          <%= for level <- 1..6 do %>
            <.link
              patch={~p"/users/#{@user.id}/kanji?sl=#{level}"}
              class={[
                "px-4 py-2 rounded-xl font-medium transition-all duration-200",
                if(@filter_type == :school && @school_level == level,
                  do: "bg-secondary text-secondary-content shadow-md",
                  else: "bg-base-200 text-secondary hover:bg-base-300 hover:text-secondary"
                )
              ]}
            >
              SL{level}
            </.link>
          <% end %>
          <%= if @filter_type == :school do %>
            <.link
              patch={~p"/users/#{@user.id}/kanji"}
              class="px-4 py-2 rounded-xl font-medium bg-base-200 text-secondary hover:bg-base-300 transition-colors"
            >
              {gettext("All levels")}
            </.link>
          <% end %>
        </div>
      </div>
    </div>

    <%!-- Stats + Actions --%>
    <div class="mb-6 flex flex-wrap items-center justify-between gap-3">
      <div class="flex flex-wrap items-center gap-3 text-sm text-secondary">
        <span class="bg-base-200 px-3 py-1.5 rounded-full">
          {@total_count} {gettext("kanji learned")}
        </span>
        <span class="bg-base-200 px-3 py-1.5 rounded-full">
          {gettext("Page %{page} of %{total}", page: @page, total: @total_pages)}
        </span>
        <%= cond do %>
          <% @filter_type == :search -> %>
            <span class="bg-primary/10 text-primary px-3 py-1.5 rounded-full">
              {gettext("Search results for")} "{@search_query}"
            </span>
          <% @filter_type == :jlpt -> %>
            <span class="bg-base-200 px-3 py-1.5 rounded-full">
              JLPT N{@jlpt_level}
            </span>
          <% @filter_type == :school -> %>
            <span class="bg-base-200 px-3 py-1.5 rounded-full">
              {gettext("School Level")} SL{@school_level}
            </span>
          <% true -> %>
        <% end %>
      </div>
      <%= if @current_scope.current_user && @current_scope.current_user.id == @user.id do %>
        <.link
          navigate={~p"/users/#{@user.id}/kanji/practice"}
          class="btn btn-primary btn-sm"
        >
          <.icon name="hero-pencil" class="w-4 h-4 mr-1" />
          {gettext("Practice Kanji")}
        </.link>
      <% end %>
    </div>

    <%!-- Kanji Grid --%>
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4">
      <%= for k <- @kanji do %>
        <div class="group relative bg-base-100 border border-base-300 rounded-xl p-5 shadow-sm hover:shadow-md hover:border-primary/30 hover:-translate-y-0.5 transition-all duration-200">
          <%!-- Unlearn button (only for current user) --%>
          <%= if @current_scope.current_user && @current_scope.current_user.id == @user.id do %>
            <button
              type="button"
              phx-click="unlearn_kanji"
              phx-value-id={k.id}
              data-confirm={
                gettext("Are you sure? This will remove '%{kanji}' from your learned kanji.",
                  kanji: k.character
                )
              }
              class="absolute top-2 right-2 p-1.5 rounded-lg text-base-content/30 hover:text-error hover:bg-error/10 transition-colors opacity-0 group-hover:opacity-100"
              title={gettext("Remove from learned")}
            >
              <.icon name="hero-trash" class="w-4 h-4" />
            </button>
          <% end %>

          <.link navigate={~p"/kanji/#{k.id}"} class="block text-center">
            <%!-- Kanji Character --%>
            <div class="text-4xl font-medium text-base-content group-hover:text-primary transition-colors mb-3">
              {k.character}
            </div>

            <%!-- Meanings --%>
            <p class="text-sm text-secondary line-clamp-2 mb-3">
              {Enum.join(k.meanings, ", ")}
            </p>

            <%!-- JLPT Level Badge --%>
            <span class={[
              "inline-block px-2 py-0.5 rounded text-xs font-medium",
              case k.jlpt_level do
                5 ->
                  "bg-emerald-100/80 text-emerald-700 dark:bg-emerald-900/40 dark:text-emerald-300"

                4 ->
                  "bg-lime-100/80 text-lime-700 dark:bg-lime-900/40 dark:text-lime-300"

                3 ->
                  "bg-yellow-100/80 text-yellow-700 dark:bg-yellow-900/40 dark:text-yellow-300"

                2 ->
                  "bg-orange-100/80 text-orange-700 dark:bg-orange-900/40 dark:text-orange-300"

                1 ->
                  "bg-red-100/80 text-red-700 dark:bg-red-900/40 dark:text-red-300"

                _ ->
                  "bg-gray-100/80 text-gray-700 dark:bg-gray-700/40 dark:text-gray-300"
              end
            ]}>
              N{k.jlpt_level}
            </span>

            <%!-- Stroke count --%>
            <span class="inline-block px-2 py-0.5 rounded text-xs font-medium bg-base-200 text-base-content/70 ml-1">
              {k.stroke_count} {gettext("strokes")}
            </span>

            <%!-- Known score --%>
            <span
              class="inline-block px-2 py-0.5 rounded text-xs font-medium bg-info/10 text-info ml-1"
              title={gettext("Known score from daily challenges")}
            >
              {gettext("Known")}: {k.known_score}
            </span>
          </.link>
        </div>
      <% end %>
    </div>

    <%!-- Empty State --%>
    <%= if @kanji == [] do %>
      <div class="text-center py-16">
        <div class="text-6xl mb-4">🈳</div>
        <h3 class="text-lg font-medium text-base-content mb-2">
          <%= cond do %>
            <% @filter_type == :search -> %>
              {gettext("No kanji found for")} "{@search_query}"
            <% @filter_type in [:jlpt, :school] -> %>
              {gettext("No kanji match the selected filter")}
            <% true -> %>
              {gettext("No kanji learned yet")}
          <% end %>
        </h3>
        <p class="text-secondary mb-6">
          <%= cond do %>
            <% @filter_type == :search -> %>
              {gettext("Try a different search term or clear the filter.")}
            <% @filter_type in [:jlpt, :school] -> %>
              {gettext("Try another level or clear the filter.")}
            <% true -> %>
              {gettext("Start learning by completing lessons or browsing kanji.")}
          <% end %>
        </p>
        <%= if @filter_type != :all do %>
          <.link
            patch={~p"/users/#{@user.id}/kanji"}
            class="inline-flex items-center px-6 py-3 bg-primary text-primary-content rounded-xl font-medium hover:bg-primary/90 transition-colors"
          >
            <.icon name="hero-x-mark" class="w-5 h-5 mr-2" />
            {gettext("Clear filters")}
          </.link>
        <% else %>
          <.link
            navigate={~p"/lessons"}
            class="inline-flex items-center px-6 py-3 bg-primary text-primary-content rounded-xl font-medium hover:bg-primary/90 transition-colors"
          >
            <.icon name="hero-book-open" class="w-5 h-5 mr-2" />
            {gettext("Start Learning")}
          </.link>
        <% end %>
      </div>
    <% end %>

    <%!-- Pagination --%>
    <%= if @total_pages > 1 do %>
      <div class="mt-8 flex justify-center">
        <div class="flex items-center gap-2 flex-wrap justify-center">
          <%= if @page > 1 do %>
            <button
              phx-click="change_page"
              phx-value-page={@page - 1}
              class="px-4 py-2 bg-base-200 text-secondary rounded-lg hover:bg-base-300 transition-colors"
            >
              ← {gettext("Prev")}
            </button>
          <% else %>
            <span class="px-4 py-2 bg-base-200/50 text-secondary/40 rounded-lg cursor-not-allowed">
              ← {gettext("Prev")}
            </span>
          <% end %>

          <div class="flex items-center gap-1">
            <%= for p <- max(1, @page - 2)..min(@total_pages, @page + 2) do %>
              <%= if p == @page do %>
                <span class="px-3 py-2 bg-primary text-primary-content rounded-lg font-medium">
                  {p}
                </span>
              <% else %>
                <button
                  phx-click="change_page"
                  phx-value-page={p}
                  class="px-3 py-2 text-secondary hover:bg-base-200 rounded-lg transition-colors"
                >
                  {p}
                </button>
              <% end %>
            <% end %>
          </div>

          <%= if @page < @total_pages do %>
            <button
              phx-click="change_page"
              phx-value-page={@page + 1}
              class="px-4 py-2 bg-base-200 text-secondary rounded-lg hover:bg-base-300 transition-colors"
            >
              {gettext("Next")} →
            </button>
          <% else %>
            <span class="px-4 py-2 bg-base-200/50 text-secondary/40 rounded-lg cursor-not-allowed">
              {gettext("Next")} →
            </span>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</Layouts.app>
