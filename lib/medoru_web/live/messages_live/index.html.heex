<Layouts.app flash={@flash} current_scope={@current_scope} socket={@socket}>
  <div class="max-w-2xl mx-auto px-4 py-8">
    <%!-- Header --%>
    <div class="flex items-center justify-between mb-6">
      <h1 class="text-2xl font-bold text-base-content">
        {gettext("Messages")}
      </h1>
      <.link
        navigate={~p"/users"}
        class="btn btn-sm btn-primary"
      >
        <.icon name="hero-plus" class="w-4 h-4 mr-1" />
        {gettext("New Message")}
      </.link>
    </div>

    <%!-- Conversations List --%>
    <div class="space-y-2">
      <%= for conversation <- @conversations do %>
        <% unread = unread_count(conversation, @current_scope.current_user.id) %>

        <.link
          navigate={~p"/messages/#{conversation.id}"}
          class={[
            "group flex items-center gap-4 p-4 rounded-xl border transition-all",
            if unread > 0 do
              "bg-primary/5 border-primary/20 hover:bg-primary/10"
            else
              "bg-base-100 border-base-300 hover:border-primary/30 hover:shadow-sm"
            end
          ]}
        >
          <%!-- Avatar --%>
          <%= if avatar = conversation_avatar(conversation, @current_scope.current_user.id) do %>
            <img
              src={avatar}
              alt=""
              class="w-12 h-12 rounded-full object-cover ring-2 ring-base-200 shrink-0"
            />
          <% else %>
            <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center ring-2 ring-base-200 shrink-0">
              <%= if conversation.is_group do %>
                <.icon name="hero-users" class="w-6 h-6 text-primary/50" />
              <% else %>
                <.icon name="hero-user" class="w-6 h-6 text-primary/50" />
              <% end %>
            </div>
          <% end %>

          <%!-- Content --%>
          <div class="flex-1 min-w-0">
            <div class="flex items-center justify-between">
              <h3 class={[
                "font-medium truncate",
                unread > 0 && "text-base-content"
              ]}>
                {conversation_name(conversation, @current_scope.current_user.id)}
              </h3>
              <span class="text-xs text-base-content/50 shrink-0 ml-2">
                {last_message_time(conversation)}
              </span>
            </div>
            <p class={[
              "text-sm truncate mt-0.5",
              unread > 0 && "text-base-content font-medium",
              unread == 0 && "text-base-content/60"
            ]}>
              {last_message_preview(conversation)}
            </p>
          </div>

          <%!-- Unread Badge --%>
          <%= if unread > 0 do %>
            <span class="badge badge-primary badge-sm shrink-0">
              {unread}
            </span>
          <% end %>
        </.link>
      <% end %>
    </div>

    <%!-- Empty State --%>
    <%= if @conversations == [] do %>
      <div class="text-center py-16">
        <div class="text-6xl mb-4">💬</div>
        <h3 class="text-lg font-medium text-base-content mb-2">
          {gettext("No messages yet")}
        </h3>
        <p class="text-secondary mb-6">
          {gettext("Start a conversation with another learner.")}
        </p>
        <.link
          navigate={~p"/users"}
          class="inline-flex items-center px-6 py-3 bg-primary text-primary-content rounded-xl font-medium hover:bg-primary/90 transition-colors"
        >
          <.icon name="hero-users" class="w-5 h-5 mr-2" />
          {gettext("Find Users")}
        </.link>
      </div>
    <% end %>
  </div>
</Layouts.app>
