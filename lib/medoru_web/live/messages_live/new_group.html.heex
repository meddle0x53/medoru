<Layouts.app flash={@flash} current_scope={@current_scope} socket={@socket}>
  <div
    class="max-w-2xl mx-auto px-4 py-8"
    id="group-creator"
    phx-hook="GroupChatCreator"
    data-participant-public-keys={Jason.encode!(@participant_public_keys)}
    data-current-user-id={@current_scope.current_user.id}
  >
    <h1 class="text-2xl font-bold text-base-content mb-6">
      {gettext("New Group Chat")}
    </h1>

    <%= if @error do %>
      <div class="alert alert-error mb-4">
        <.icon name="hero-exclamation-triangle" class="w-5 h-5" />
        <span>{@error}</span>
      </div>
    <% end %>

    <%= if @missing_keys != [] do %>
      <div class="alert alert-warning mb-4">
        <.icon name="hero-exclamation-triangle" class="w-5 h-5" />
        <span>
          {gettext("Some participants haven't set up encryption yet. They won't be able to read messages until they do.")}
        </span>
      </div>
    <% end %>

    <%!-- Participants --%>
    <div class="mb-6">
      <h2 class="text-sm font-medium text-base-content/70 mb-3">
        {gettext("Participants")}
      </h2>
      <div class="flex flex-wrap gap-2">
        <%= for user <- @users do %>
          <div class="flex items-center gap-2 bg-base-200 px-3 py-1.5 rounded-full">
            <%= if avatar = user_avatar(user) do %>
              <img src={avatar} alt="" class="w-5 h-5 rounded-full object-cover" />
            <% else %>
              <.icon name="hero-user" class="w-5 h-5 text-base-content/40" />
            <% end %>
            <span class="text-sm">{user_display_name(user)}</span>
          </div>
        <% end %>
      </div>
    </div>

    <%!-- Group Name --%>
    <div class="mb-6">
      <label class="block text-sm font-medium text-base-content/70 mb-2">
        {gettext("Group Name")}
      </label>
      <input
        type="text"
        id="group-title-input"
        value={@title}
        placeholder={gettext("Enter group name...")}
        class="w-full px-4 py-3 bg-base-200 border-0 rounded-2xl text-base-content placeholder:text-base-content/40 focus:outline-none focus:ring-2 focus:ring-primary/20"
      />
    </div>

    <button
      id="create-group-button"
      type="button"
      class="btn btn-primary w-full sm:w-auto"
    >
      <.icon name="hero-users" class="w-5 h-5 mr-2" />
      {gettext("Create Group Chat")}
    </button>
  </div>
</Layouts.app>
