<Layouts.app flash={@flash} current_scope={@current_scope} socket={@socket}>
  <div id="profile-settings" phx-hook="Theme" class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <%!-- Push notifications hook is on the button itself --%>
    <%!-- Header --%>
    <div class="mb-8">
      <h1 class="text-3xl font-bold text-base-content">{gettext("Profile Settings")}</h1>
      <p class="mt-2 text-secondary">
        {gettext("Update your public profile information.")}
      </p>
    </div>

    <%!-- Profile Form --%>
    <div class="card bg-base-100 shadow-sm border border-base-300">
      <div class="card-body">
        <.form
          for={@form}
          id="profile-form"
          phx-change="validate"
          phx-submit="save"
          class="space-y-6"
        >
          <%!-- Display Name --%>
          <div class="form-control">
            <label class="label">
              <span class="label-text font-medium">{gettext("Display Name")}</span>
              <span class="label-text-alt text-base-content/50">{gettext("Required")}</span>
            </label>
            <input
              type="text"
              name={@form[:display_name].name}
              value={@form[:display_name].value}
              placeholder={gettext("How you want to be known")}
              class={[
                "input input-bordered w-full min-h-[44px] text-base",
                @form[:display_name].errors != [] && "input-error"
              ]}
              maxlength="50"
            />
            <label class="label">
              <span class="label-text-alt text-base-content/50">
                {gettext("This will be shown on your public profile and in rankings.")}
              </span>
              <span class="label-text-alt text-error">
                {Enum.map(@form[:display_name].errors || [], &elem(&1, 0))}
              </span>
            </label>
          </div>

          <%!-- Theme --%>
          <div class="form-control">
            <label class="label">
              <span class="label-text font-medium">{gettext("Theme")}</span>
            </label>
            <div class="flex gap-3">
              <label class={[
                "flex-1 cursor-pointer border rounded-xl p-3 text-center transition-all",
                @form[:theme].value == "light" && "border-primary bg-primary/10",
                @form[:theme].value != "light" && "border-base-300 hover:border-primary/50"
              ]}>
                <input
                  type="radio"
                  name={@form[:theme].name}
                  value="light"
                  checked={@form[:theme].value == "light"}
                  class="hidden"
                />
                <.icon name="hero-sun" class="w-6 h-6 mb-1" />
                <div class="text-sm font-medium">{gettext("Light")}</div>
              </label>
              <label class={[
                "flex-1 cursor-pointer border rounded-xl p-3 text-center transition-all",
                @form[:theme].value == "dark" && "border-primary bg-primary/10",
                @form[:theme].value != "dark" && "border-base-300 hover:border-primary/50"
              ]}>
                <input
                  type="radio"
                  name={@form[:theme].name}
                  value="dark"
                  checked={@form[:theme].value == "dark"}
                  class="hidden"
                />
                <.icon name="hero-moon" class="w-6 h-6 mb-1" />
                <div class="text-sm font-medium">{gettext("Dark")}</div>
              </label>
              <label class={[
                "flex-1 cursor-pointer border rounded-xl p-3 text-center transition-all",
                @form[:theme].value == "system" && "border-primary bg-primary/10",
                @form[:theme].value != "system" && "border-base-300 hover:border-primary/50"
              ]}>
                <input
                  type="radio"
                  name={@form[:theme].name}
                  value="system"
                  checked={@form[:theme].value == "system"}
                  class="hidden"
                />
                <.icon name="hero-computer-desktop" class="w-6 h-6 mb-1" />
                <div class="text-sm font-medium">{gettext("System")}</div>
              </label>
            </div>
            <label class="label">
              <span class="label-text-alt text-base-content/50">
                {gettext("Choose your preferred color theme.")}
              </span>
            </label>
          </div>

          <%!-- Bio --%>
          <div class="form-control">
            <label class="label">
              <span class="label-text font-medium">{gettext("Bio")}</span>
              <span class="label-text-alt text-base-content/50">{gettext("Optional")}</span>
            </label>
            <textarea
              name={@form[:bio].name}
              value={@form[:bio].value}
              placeholder={gettext("Tell us a bit about yourself...")}
              class={[
                "textarea textarea-bordered w-full h-32 resize-none text-base",
                @form[:bio].errors != [] && "textarea-error"
              ]}
              maxlength="500"
            >{@form[:bio].value}</textarea>
            <label class="label">
              <span class="label-text-alt text-base-content/50">
                {gettext("Brief description for your profile. Max 500 characters.")}
              </span>
              <span class="label-text-alt">
                {String.length(@form[:bio].value || "")}/500
              </span>
            </label>
          </div>

          <%!-- Age --%>
          <div class="form-control">
            <label class="label">
              <span class="label-text font-medium">{gettext("Age")}</span>
              <span class="label-text-alt text-base-content/50">{gettext("Optional")}</span>
            </label>
            <input
              type="number"
              name={@form[:age].name}
              value={@form[:age].value}
              placeholder={gettext("Your age")}
              class={[
                "input input-bordered w-full min-h-[44px] text-base",
                @form[:age].errors != [] && "input-error"
              ]}
              min="1"
              max="120"
            />
            <label class="label">
              <span class="label-text-alt text-error">
                {Enum.map(@form[:age].errors || [], &elem(&1, 0))}
              </span>
            </label>
          </div>

          <%!-- Gender --%>
          <div class="form-control">
            <label class="label">
              <span class="label-text font-medium">{gettext("Gender")}</span>
              <span class="label-text-alt text-base-content/50">{gettext("Optional")}</span>
            </label>
            <select
              name={@form[:gender].name}
              class={[
                "select select-bordered w-full min-h-[44px] text-base",
                @form[:gender].errors != [] && "select-error"
              ]}
            >
              <option value="">{gettext("Not specified")}</option>
              <option value="0" selected={to_string(@form[:gender].value) == "0"}>
                {gettext("Male")}
              </option>
              <option value="1" selected={to_string(@form[:gender].value) == "1"}>
                {gettext("Female")}
              </option>
              <option value="2" selected={to_string(@form[:gender].value) == "2"}>
                {gettext("Other")}
              </option>
            </select>
            <label class="label">
              <span class="label-text-alt text-error">
                {Enum.map(@form[:gender].errors || [], &elem(&1, 0))}
              </span>
            </label>
          </div>

          <%!-- Location --%>
          <div class="form-control">
            <label class="label">
              <span class="label-text font-medium">{gettext("Location")}</span>
              <span class="label-text-alt text-base-content/50">{gettext("Optional")}</span>
            </label>
            <input
              type="text"
              name={@form[:location].name}
              value={@form[:location].value}
              placeholder={gettext("City, Country")}
              class={[
                "input input-bordered w-full min-h-[44px] text-base",
                @form[:location].errors != [] && "input-error"
              ]}
              maxlength="100"
            />
            <label class="label">
              <span class="label-text-alt text-base-content/50">
                {gettext("Where you're based. Max 100 characters.")}
              </span>
              <span class="label-text-alt text-error">
                {Enum.map(@form[:location].errors || [], &elem(&1, 0))}
              </span>
            </label>
          </div>

          <%!-- Avatar Upload --%>
          <div class="form-control">
            <label class="label">
              <span class="label-text font-medium">{gettext("Avatar")}</span>
              <span class="label-text-alt text-base-content/50">{gettext("Optional")}</span>
            </label>

            <%!-- Current Avatar --%>
            <%= if @profile.avatar do %>
              <div class="flex items-center gap-4 mb-4">
                <img
                  src={@profile.avatar}
                  alt="Current avatar"
                  class="w-20 h-20 rounded-full object-cover ring-2 ring-base-300"
                />
                <span class="text-sm text-base-content/60">{gettext("Current avatar")}</span>
              </div>
            <% end %>

            <%!-- Upload Dropzone --%>
            <div
              phx-drop-target={@uploads.avatar.ref}
              class="border-2 border-dashed border-base-300 rounded-xl p-8 text-center hover:border-primary/50 transition-colors"
            >
              <.live_file_input upload={@uploads.avatar} class="hidden" />
              <div
                class="cursor-pointer"
                phx-click={JS.dispatch("click", to: "##{@uploads.avatar.ref}")}
              >
                <.icon
                  name="hero-cloud-arrow-up"
                  class="w-10 h-10 text-base-content/40 mx-auto mb-2"
                />
                <p class="text-sm text-base-content/60">
                  {gettext("Click to upload or drag and drop")}
                </p>
                <p class="text-xs text-base-content/40 mt-1">
                  {gettext("PNG, JPG, GIF up to 2MB")}
                </p>
              </div>
            </div>

            <%!-- Upload Preview/Errors --%>
            <%= for entry <- @uploads.avatar.entries do %>
              <div class="mt-4 p-4 bg-base-200 rounded-lg">
                <div class="flex items-center justify-between">
                  <div class="flex items-center gap-3">
                    <.live_img_preview entry={entry} class="w-12 h-12 rounded object-cover" />
                    <div>
                      <p class="text-sm font-medium">{entry.client_name}</p>
                      <p class="text-xs text-base-content/60">
                        {entry.client_type} · {format_bytes(entry.client_size)}
                      </p>
                    </div>
                  </div>
                  <button
                    type="button"
                    phx-click="cancel-upload"
                    phx-value-ref={entry.ref}
                    class="btn btn-ghost btn-sm btn-circle"
                  >
                    <.icon name="hero-x-mark" class="w-4 h-4" />
                  </button>
                </div>

                <%!-- Progress Bar --%>
                <div class="mt-2">
                  <progress
                    value={entry.progress}
                    max="100"
                    class="progress progress-primary w-full"
                  >
                    {entry.progress}%
                  </progress>
                </div>

                <%!-- Errors --%>
                <%= for err <- upload_errors(@uploads.avatar, entry) do %>
                  <p class="text-error text-sm mt-1">{error_to_string(err)}</p>
                <% end %>
              </div>
            <% end %>

            <%= for err <- upload_errors(@uploads.avatar) do %>
              <p class="text-error text-sm mt-2">{error_to_string(err)}</p>
            <% end %>
          </div>

          <%!-- Tags --%>
          <div class="form-control">
            <label class="label">
              <span class="label-text font-medium">{gettext("Tags")}</span>
              <span class="label-text-alt text-base-content/50">
                {gettext("%{count}/15 selected", count: length(@selected_tag_ids))}
              </span>
            </label>
            <p class="text-sm text-base-content/60 mb-3">
              {gettext(
                "Select tags that describe your interests. These will appear on your public profile."
              )}
            </p>
            <div class="space-y-4">
              <%= for {category, tags} <- @tags_by_category do %>
                <div>
                  <h4 class="text-xs font-semibold text-base-content/50 uppercase tracking-wider mb-2">
                    {category}
                  </h4>
                  <div class="flex flex-wrap gap-2">
                    <%= for tag <- tags do %>
                      <button
                        type="button"
                        phx-click="toggle_tag"
                        phx-value-tag_id={tag.id}
                        class={[
                          "badge badge-lg cursor-pointer transition-all",
                          tag.id in @selected_tag_ids && tag_color_classes(tag.color),
                          tag.id not in @selected_tag_ids && "badge-outline hover:bg-base-200"
                        ]}
                      >
                        {tag.name}
                      </button>
                    <% end %>
                  </div>
                </div>
              <% end %>
            </div>
          </div>

          <%!-- Profile Visibility --%>
          <div class="form-control pt-4 border-t border-base-300">
            <label class="label">
              <span class="label-text font-medium">{gettext("Profile Visibility")}</span>
            </label>
            <label class="flex items-center gap-3 cursor-pointer">
              <input type="hidden" name={@form[:is_public].name} value="false" />
              <input
                type="checkbox"
                name={@form[:is_public].name}
                value="true"
                checked={@form[:is_public].value}
                class="checkbox checkbox-primary"
              />
              <span class="text-sm text-base-content">
                {gettext("Show my profile in the user directory")}
              </span>
            </label>
            <label class="label">
              <span class="label-text-alt text-base-content/50">
                {gettext(
                  "When disabled, others can still visit your profile directly but won't find you in search or tag filters."
                )}
              </span>
            </label>
          </div>

          <%!-- Safety Mode --%>
          <div class="form-control pt-4 border-t border-base-300">
            <label class="label">
              <span class="label-text font-medium">{gettext("Safety Mode")}</span>
            </label>
            <label class="flex items-center gap-3 cursor-pointer">
              <input type="hidden" name={@form[:safety].name} value="false" />
              <input
                type="checkbox"
                name={@form[:safety].name}
                value="true"
                checked={@form[:safety].value}
                class="checkbox checkbox-primary"
              />
              <span class="text-sm text-base-content">
                {gettext("Hide mature content")}
              </span>
            </label>
            <label class="label">
              <span class="label-text-alt text-base-content/50">
                {gettext(
                  "When enabled, words marked as mature are hidden. Requires age 18+ to disable."
                )}
              </span>
            </label>
          </div>

          <%!-- Notification Preferences --%>
          <div class="form-control pt-4 border-t border-base-300">
            <label class="label">
              <span class="label-text font-medium">{gettext("Notification Preferences")}</span>
            </label>
            <div class="space-y-3">
              <label class="flex items-center gap-3 cursor-pointer">
                <input type="hidden" name={@form[:notify_messaging].name} value="false" />
                <input
                  type="checkbox"
                  name={@form[:notify_messaging].name}
                  value="true"
                  checked={@form[:notify_messaging].value}
                  class="checkbox checkbox-primary"
                />
                <span class="text-sm text-base-content">
                  {gettext("Enable messaging notifications")}
                </span>
              </label>
              <label class="flex items-center gap-3 cursor-pointer">
                <input type="hidden" name={@form[:notify_white_board].name} value="false" />
                <input
                  type="checkbox"
                  name={@form[:notify_white_board].name}
                  value="true"
                  checked={@form[:notify_white_board].value}
                  class="checkbox checkbox-primary"
                />
                <span class="text-sm text-base-content">
                  {gettext("Enable white board notifications")}
                </span>
              </label>
              <label class="flex items-center gap-3 cursor-pointer">
                <input type="hidden" name={@form[:notify_achievements].name} value="false" />
                <input
                  type="checkbox"
                  name={@form[:notify_achievements].name}
                  value="true"
                  checked={@form[:notify_achievements].value}
                  class="checkbox checkbox-primary"
                />
                <span class="text-sm text-base-content">
                  {gettext("Enable achievement notifications")}
                </span>
              </label>
            </div>
          </div>

          <%!-- Submit Button --%>
          <div class="flex flex-col-reverse md:flex-row md:items-center md:justify-between pt-4 border-t border-base-300 gap-3">
            <.link navigate={~p"/dashboard"} class="btn btn-ghost w-full md:w-auto">
              {gettext("Cancel")}
            </.link>
            <button
              type="submit"
              class="btn btn-primary w-full md:w-auto min-h-[48px] touch-target"
              disabled={@form.errors != []}
            >
              <.icon name="hero-check" class="w-5 h-5 mr-2" /> {gettext("Save Changes")}
            </button>
          </div>
        </.form>
      </div>
    </div>

    <%!-- Push Debug Panel --%>
    <div class="card bg-base-100 shadow-sm border border-base-300 mt-6">
      <div class="card-body">
        <h2 class="card-title text-lg">
          <.icon name="hero-bug-ant" class="w-5 h-5 text-secondary" /> Push Debug
        </h2>
        <%!-- Server-side rendered values --%>
        <div class="text-xs font-mono space-y-1 mt-2 mb-3 p-3 bg-base-200 rounded-lg">
          <div class="flex justify-between">
            <span class="text-base-content/60">Server VAPID key length:</span>
            <span class="font-bold text-base-content">
              {String.length(Application.get_env(:medoru, :vapid_details, %{})[:public_key] || "")}
            </span>
          </div>
          <div class="flex justify-between">
            <span class="text-base-content/60">Server VAPID key present:</span>
            <span class="font-bold text-base-content">
              {!!Application.get_env(:medoru, :vapid_details, %{})[:public_key]}
            </span>
          </div>
          <div class="flex justify-between">
            <span class="text-base-content/60">Meta tag content:</span>
            <span class="font-bold text-base-content" id="meta-vapid-check">checking...</span>
          </div>
        </div>
        <div id="push-debug-panel" phx-update="ignore" class="text-xs font-mono space-y-1">
          <script>
            (function() {
              const el = document.getElementById('push-debug-panel');
              const metaCheck = document.getElementById('meta-vapid-check');
              if (!el) return;
              const meta = document.querySelector("meta[name='vapid-public-key']");
              const metaContent = meta ? meta.getAttribute('content') : 'NO META TAG';
              if (metaCheck) metaCheck.textContent = metaContent ? 'present (' + metaContent.length + ' chars)' : 'EMPTY';
              window.medoruVapidKey = metaContent || "";
              const vapid = window.medoruVapidKey;
              const isStandalone = window.matchMedia('(display-mode: standalone)').matches || window.navigator.standalone === true;
              const isIOS = /iPad|iPhone|iPod/.test(navigator.userAgent);
              const checks = [
                ['Platform', isIOS ? 'iOS' : 'Other'],
                ['PWA standalone', isStandalone],
                ['VAPID key length', vapid.length],
                ['VAPID key present', !!vapid],
                ['serviceWorker', 'serviceWorker' in navigator],
                ['PushManager', 'PushManager' in window],
                ['Notification', 'Notification' in window],
                ['Permission', 'Notification' in window ? Notification.permission : 'n/a'],
                ['SW registered', navigator.serviceWorker ? 'checking...' : 'n/a'],
              ];
              el.innerHTML = checks.map(([name, val]) =>
                `<div class="flex justify-between"><span class="text-base-content/60">${name}:</span><span class="font-bold ${val === true || val === 'granted' ? 'text-success' : val === false || val === 'denied' ? 'text-error' : 'text-base-content'}">${val}</span></div>`
              ).join('');
              if (navigator.serviceWorker) {
                navigator.serviceWorker.getRegistration().then(reg => {
                  const swEl = el.querySelector('div:last-child');
                  if (swEl) swEl.innerHTML = swEl.innerHTML.replace('checking...', reg ? 'yes (' + (reg.scope || '?') + ')' : 'no');
                });
              }
            })();
          </script>
        </div>
      </div>
    </div>

    <%!-- Push Notifications Toggle --%>
    <div class="card bg-base-100 shadow-sm border border-base-300 mt-6">
      <div class="card-body">
        <h2 class="card-title text-lg">
          <.icon name="hero-bell" class="w-5 h-5 text-primary" /> {gettext("Push Notifications")}
        </h2>
        <p class="text-sm text-base-content/60 mb-4">
          {gettext("Get notified about new chat messages even when Medoru is closed.")}
        </p>

        <%!-- Platform-specific guidance --%>
        <div
          id="push-platform-help"
          phx-update="ignore"
          class="hidden mb-4 p-3 bg-info/10 border border-info/30 rounded-lg text-sm"
        >
          <p class="font-medium text-info mb-1" id="push-platform-title"></p>
          <p class="text-base-content/70" id="push-platform-desc"></p>
          <script>
            (function() {
              const isIOS = /iPad|iPhone|iPod/.test(navigator.userAgent);
              const isSafari = /^((?!chrome|android).)*safari/i.test(navigator.userAgent);
              const isFirefox = navigator.userAgent.toLowerCase().includes('firefox');
              const isStandalone = window.matchMedia('(display-mode: standalone)').matches || window.navigator.standalone === true;
              const el = document.getElementById('push-platform-help');
              const title = document.getElementById('push-platform-title');
              const desc = document.getElementById('push-platform-desc');
              if (!el || !title || !desc) return;

              if (isIOS && isFirefox) {
                el.classList.remove('hidden');
                title.textContent = 'iOS Firefox is not supported';
                desc.textContent = 'Apple requires all iOS browsers to use Safari\'s engine, which does not allow push notifications in Firefox. Please use Safari instead.';
              } else if (isIOS && isSafari && !isStandalone) {
                el.classList.remove('hidden');
                title.textContent = 'Install as app first';
                desc.textContent = 'On iOS, tap the Share button in Safari, then "Add to Home Screen". Open Medoru from the home screen icon, then return here to enable push notifications.';
              } else if (isIOS && isSafari && isStandalone) {
                el.classList.remove('hidden');
                title.textContent = 'iOS PWA mode active';
                desc.textContent = 'You\'re running in PWA mode. If push is still not supported, make sure iOS is 16.4 or newer.';
              }
            })();
          </script>
        </div>

        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between p-4 bg-base-200 rounded-xl border border-base-300 gap-3">
          <div class="flex items-center gap-3">
            <div class={[
              "p-2 rounded-lg shrink-0",
              @profile.push_notifications_enabled && "bg-primary/10 text-primary",
              !@profile.push_notifications_enabled && "bg-base-300 text-base-content/50"
            ]}>
              <.icon
                name={
                  if @profile.push_notifications_enabled, do: "hero-bell", else: "hero-bell-slash"
                }
                class="w-5 h-5"
              />
            </div>
            <div class="min-w-0">
              <p class="font-medium text-base-content">
                {if @profile.push_notifications_enabled,
                  do: gettext("Enabled"),
                  else: gettext("Disabled")}
              </p>
              <p class="text-xs text-base-content/50">
                {if @profile.push_notifications_enabled,
                  do: gettext("You'll receive push notifications for chat messages."),
                  else: gettext("Turn on to receive push notifications.")}
              </p>
            </div>
          </div>
          <button
            type="button"
            id="push-notifications-toggle"
            phx-click="toggle_push_notifications"
            phx-hook="PushNotificationsHook"
            data-enabled={@profile.push_notifications_enabled}
            class={[
              "btn w-full sm:w-auto",
              @profile.push_notifications_enabled && "btn-error btn-outline",
              !@profile.push_notifications_enabled && "btn-primary"
            ]}
          >
            {if @profile.push_notifications_enabled,
              do: gettext("Disable"),
              else: gettext("Enable")}
          </button>
        </div>
      </div>
    </div>

    <%!-- Featured Badge Section --%>
    <%= if length(@user_badges) > 0 do %>
      <div class="card bg-base-100 shadow-sm border border-base-300 mt-6">
        <div class="card-body">
          <h2 class="card-title text-lg">
            <.icon name="hero-trophy" class="w-5 h-5 text-warning" /> {gettext("Featured Badge")}
          </h2>
          <p class="text-sm text-base-content/60 mb-4">
            {gettext("Choose a badge to feature on your public profile.")}
          </p>

          <%!-- Current Featured Badge --%>
          <%= if @featured_badge do %>
            <div class="mb-4 p-4 bg-gradient-to-r from-warning/10 to-transparent rounded-xl border border-warning/20">
              <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
                <div class="flex items-center gap-3">
                  <div class={[
                    "p-3 rounded-xl shrink-0",
                    badge_color_class(@featured_badge.badge.color)
                  ]}>
                    <.icon name={"hero-#{@featured_badge.badge.icon}"} class="w-6 h-6" />
                  </div>
                  <div class="min-w-0">
                    <p class="font-semibold text-base-content">{@featured_badge.badge.name}</p>
                    <p class="text-sm text-base-content/60">
                      {@featured_badge.badge.description}
                    </p>
                  </div>
                </div>
                <span class="badge badge-warning shrink-0">{gettext("Currently Featured")}</span>
              </div>
            </div>

            <button
              phx-click="remove_featured_badge"
              class="btn btn-ghost btn-sm"
            >
              <.icon name="hero-x-mark" class="w-4 h-4 mr-1" /> {gettext("Remove Featured Badge")}
            </button>
          <% else %>
            <p class="text-sm text-base-content/50 mb-4">
              {gettext("No badge currently featured.")}
            </p>
          <% end %>

          <%!-- Badge Selection Grid --%>
          <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 mt-4">
            <%= for user_badge <- @user_badges do %>
              <button
                phx-click="set_featured_badge"
                phx-value-badge_id={user_badge.badge.id}
                class={[
                  "flex items-center gap-3 p-3 rounded-xl border transition-all text-left",
                  "hover:scale-105 hover:shadow-sm",
                  user_badge.is_featured && "ring-2 ring-warning border-warning",
                  !user_badge.is_featured && "bg-base-200 border-base-300 hover:border-primary/50"
                ]}
                disabled={user_badge.is_featured}
              >
                <div class={["p-2 rounded-lg", badge_color_class(user_badge.badge.color)]}>
                  <.icon name={"hero-#{user_badge.badge.icon}"} class="w-4 h-4" />
                </div>
                <span class="text-sm font-medium truncate">{user_badge.badge.name}</span>
              </button>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>

    <%!-- API Tokens Section --%>
    <div class="card bg-base-100 shadow-sm border border-base-300 mt-6">
      <div class="card-body">
        <h2 class="card-title text-lg">
          <.icon name="hero-key" class="w-5 h-5 text-primary" /> {gettext("API Tokens")}
        </h2>
        <p class="text-sm text-base-content/60 mb-4">
          {gettext("Manage API tokens for external integrations. You can create up to 3 tokens.")}
        </p>

        <%!-- Newly created token alert --%>
        <%= if @new_token_plaintext do %>
          <div class="mb-6 p-4 bg-warning/10 border border-warning/30 rounded-xl">
            <div class="flex items-start gap-3">
              <.icon
                name="hero-exclamation-triangle"
                class="w-5 h-5 text-warning flex-shrink-0 mt-0.5"
              />
              <div class="flex-1 min-w-0">
                <p class="font-medium text-warning">{gettext("Copy your token now")}</p>
                <p class="text-sm text-base-content/70 mb-3">
                  {gettext("This is the only time you'll see the full token.")}
                </p>
                <div class="flex items-center gap-2">
                  <code class="flex-1 bg-base-100 px-3 py-2 rounded-lg font-mono text-sm break-all border border-base-300">
                    {@new_token_plaintext}
                  </code>
                  <button
                    type="button"
                    phx-click="dismiss_new_token"
                    class="btn btn-ghost btn-sm"
                  >
                    {gettext("Done")}
                  </button>
                </div>
              </div>
            </div>
          </div>
        <% end %>

        <%!-- Existing Tokens --%>
        <%= if @api_tokens == [] do %>
          <p class="text-sm text-base-content/50 py-4">{gettext("No API tokens yet.")}</p>
        <% else %>
          <div class="space-y-3 mb-6">
            <%= for token <- @api_tokens do %>
              <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between p-4 bg-base-200 rounded-xl border border-base-300 gap-3">
                <div class="min-w-0 flex-1">
                  <div class="flex items-center gap-2">
                    <span class="font-medium text-base-content truncate">
                      {token.name || gettext("Unnamed token")}
                    </span>
                    <span class="badge badge-ghost badge-sm shrink-0">
                      {mask_token(token.token_hash)}
                    </span>
                  </div>
                  <div class="flex flex-wrap items-center gap-x-3 gap-y-1 mt-1 text-xs text-base-content/60">
                    <span>{format_token_expiry(token.expires_at)}</span>
                    <span>•</span>
                    <span>
                      {gettext("Created %{date}",
                        date: Calendar.strftime(token.inserted_at, "%b %d, %Y")
                      )}
                    </span>
                    <span>•</span>
                    <span>{format_token_last_used(token.last_used_at)}</span>
                  </div>
                </div>
                <button
                  type="button"
                  phx-click="delete_api_token"
                  phx-value-id={token.id}
                  class="btn btn-ghost btn-sm text-error w-full sm:w-auto"
                  data-confirm={gettext("Are you sure you want to revoke this token?")}
                >
                  <.icon name="hero-trash" class="w-4 h-4" />
                </button>
              </div>
            <% end %>
          </div>
        <% end %>

        <%!-- Create Token Form --%>
        <%= if @api_token_count < 3 do %>
          <.form
            for={@new_token_form}
            id="api-token-form"
            phx-submit="create_api_token"
            class="border-t border-base-300 pt-4"
          >
            <div class="flex flex-col sm:flex-row gap-3">
              <input
                type="text"
                name={@new_token_form[:name].name}
                value={@new_token_form[:name].value}
                placeholder={gettext("Token name (e.g., Mobile App)")}
                class="input input-bordered flex-1"
                maxlength="100"
              />
              <select
                name={@new_token_form[:expires_in_days].name}
                class="select select-bordered sm:w-48"
              >
                <option value="">{gettext("Never expires")}</option>
                <option value="30">{gettext("Expires in 30 days")}</option>
                <option value="60">{gettext("Expires in 60 days")}</option>
                <option value="90">{gettext("Expires in 90 days")}</option>
              </select>
              <button
                type="submit"
                class="btn btn-primary"
              >
                <.icon name="hero-plus" class="w-4 h-4 mr-1" /> {gettext("Create Token")}
              </button>
            </div>
          </.form>
        <% else %>
          <p class="text-sm text-base-content/50 pt-4 border-t border-base-300">
            {gettext("Token limit reached. Revoke an existing token to create a new one.")}
          </p>
        <% end %>
      </div>

      <%!-- Fluent in Japanese (teacher/admin only) --%>
      <%= if @is_teacher do %>
        <div class="bg-base-100 rounded-2xl shadow-sm border border-base-300 p-6">
          <div class="flex items-center gap-2 mb-4">
            <.icon name="hero-language" class="w-5 h-5 text-error" />
            <h2 class="text-xl font-bold text-base-content">{gettext("Fluent in Japanese")}</h2>
          </div>

          <p class="text-sm text-base-content/70 mb-4">
            {gettext(
              "Mark all kanji and words as learned instantly. This is useful if you are already fluent in Japanese and do not want to go through the learning process."
            )}
          </p>
          <p class="text-sm text-error mb-4">
            {gettext("This action cannot be undone!")}
          </p>

          <div class="card-actions justify-end">
            <%= if @fluent_disabled do %>
              <button disabled class="btn btn-error btn-outline btn-disabled">
                <.icon name="hero-check-badge" class="w-5 h-5 mr-2" />
                {gettext("Already Fluent")}
              </button>
            <% else %>
              <%= if @show_fluent_confirm do %>
                <div class="flex items-center gap-4">
                  <span class="text-sm font-semibold">{gettext("Are you sure?")}</span>
                  <button
                    phx-click="cancel_fluent"
                    class="btn btn-ghost btn-sm"
                  >
                    {gettext("Cancel")}
                  </button>
                  <button
                    phx-click="mark_fluent"
                    class="btn btn-error btn-sm"
                  >
                    {gettext("Yes, Mark Everything")}
                  </button>
                </div>
              <% else %>
                <button
                  phx-click="confirm_fluent"
                  class="btn btn-error btn-outline"
                >
                  <.icon name="hero-check-badge" class="w-5 h-5 mr-2" />
                  {gettext("Fluent In Japanese")}
                </button>
              <% end %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</Layouts.app>
