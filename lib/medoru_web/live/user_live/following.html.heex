<Layouts.app flash={@flash} current_scope={@current_scope} socket={@socket}>
  <div class="max-w-6xl mx-auto px-4 py-8">
    <%!-- Header --%>
    <div class="mb-8">
      <div class="flex items-center gap-3 mb-2">
        <.link
          navigate={~p"/users/#{@user.id}"}
          class="text-secondary hover:text-primary transition-colors"
        >
          <.icon name="hero-arrow-left" class="w-5 h-5" />
        </.link>
        <h1 class="text-3xl font-bold text-base-content">
          {gettext("Following")}
        </h1>
      </div>
      <p class="text-secondary">
        {gettext("You are following %{count} people", count: @total_count)}
      </p>
    </div>

    <%!-- Users Grid --%>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
      <%= for followed <- @following do %>
        <div class="bg-base-100 border border-base-200 rounded-xl p-4 shadow-sm hover:shadow-md transition-shadow group">
          <%!-- Avatar --%>
          <.link navigate={~p"/users/#{followed.id}"} class="block text-center">
            <%= if avatar = user_avatar(followed) do %>
              <img
                src={avatar}
                alt=""
                class="w-16 h-16 rounded-full object-cover mx-auto mb-3 ring-2 ring-base-200 group-hover:ring-primary/30 transition-all"
              />
            <% else %>
              <div class="w-16 h-16 rounded-full bg-primary/10 flex items-center justify-center mx-auto mb-3 ring-2 ring-base-200 group-hover:ring-primary/30 transition-all">
                <.icon name="hero-user" class="w-8 h-8 text-primary/50" />
              </div>
            <% end %>

            <%!-- Name --%>
            <h3 class="font-semibold text-base-content group-hover:text-primary transition-colors truncate">
              {user_display_name(followed)}
            </h3>
            <%!-- Level --%>
            <%= if followed.stats && followed.stats.level > 0 do %>
              <span class="badge badge-primary badge-xs gap-1 mt-1">
                <.icon name="hero-sparkles" class="w-3 h-3" />
                {gettext("Lv. %{level}", level: followed.stats.level)}
              </span>
            <% end %>
          </.link>

          <%!-- Action Buttons --%>
          <%= if @current_scope.current_user && @current_scope.current_user.id != followed.id do %>
            <div class="mt-4 flex gap-2">
              <%= if followed.id in @following_ids do %>
                <button
                  type="button"
                  phx-click="unfollow_user"
                  phx-value-user_id={followed.id}
                  class="btn btn-sm btn-outline flex-1"
                >
                  <.icon name="hero-user-minus" class="w-4 h-4 mr-1" />
                  {gettext("Unfollow")}
                </button>
              <% else %>
                <button
                  type="button"
                  phx-click="follow_user"
                  phx-value-user_id={followed.id}
                  class="btn btn-sm btn-primary flex-1"
                >
                  <.icon name="hero-user-plus" class="w-4 h-4 mr-1" />
                  {gettext("Follow")}
                </button>
              <% end %>
              <.link
                navigate={~p"/messages?user=#{followed.id}"}
                class="btn btn-sm btn-outline btn-primary flex-1"
              >
                <.icon name="hero-chat-bubble-left" class="w-4 h-4 mr-1" />
                {gettext("Message")}
              </.link>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>

    <%!-- Empty State --%>
    <%= if @following == [] do %>
      <div class="text-center py-16">
        <div class="text-6xl mb-4">👥</div>
        <h3 class="text-lg font-medium text-base-content mb-2">
          {gettext("Not following anyone yet")}
        </h3>
        <p class="text-secondary mb-6">
          {gettext("People you follow will appear here.")}
        </p>
        <.link
          navigate={~p"/users"}
          class="inline-flex items-center px-6 py-3 bg-primary text-primary-content rounded-xl font-medium hover:bg-primary/90 transition-colors"
        >
          <.icon name="hero-users" class="w-5 h-5 mr-2" />
          {gettext("Discover Users")}
        </.link>
      </div>
    <% end %>

    <%!-- Pagination --%>
    <%= if @total_pages > 1 do %>
      <div class="mt-8 flex justify-center">
        <div class="flex items-center gap-2">
          <%= if @page > 1 do %>
            <button
              phx-click="change_page"
              phx-value-page={@page - 1}
              class="px-4 py-2 bg-base-200 text-secondary rounded-lg hover:bg-base-300 transition-colors"
            >
              ← {gettext("Prev")}
            </button>
          <% else %>
            <span class="px-4 py-2 bg-base-200/50 text-secondary/40 rounded-lg cursor-not-allowed">
              ← {gettext("Prev")}
            </span>
          <% end %>

          <div class="flex items-center gap-1">
            <%= for p <- max(1, @page - 2)..min(@total_pages, @page + 2) do %>
              <%= if p == @page do %>
                <span class="px-3 py-2 bg-primary text-primary-content rounded-lg font-medium">
                  {p}
                </span>
              <% else %>
                <button
                  phx-click="change_page"
                  phx-value-page={p}
                  class="px-3 py-2 text-secondary hover:bg-base-200 rounded-lg transition-colors"
                >
                  {p}
                </button>
              <% end %>
            <% end %>
          </div>

          <%= if @page < @total_pages do %>
            <button
              phx-click="change_page"
              phx-value-page={@page + 1}
              class="px-4 py-2 bg-base-200 text-secondary rounded-lg hover:bg-base-300 transition-colors"
            >
              {gettext("Next")} →
            </button>
          <% else %>
            <span class="px-4 py-2 bg-base-200/50 text-secondary/40 rounded-lg cursor-not-allowed">
              {gettext("Next")} →
            </span>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</Layouts.app>
